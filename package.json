{
  "name": "redoc",
  "version": "3.0.0-rc.1",
  "description": "ReDoc",
  "repository": {
    "type": "git",
    "url": "git://github.com/Redocly/redoc"
  },
  "browserslist": [
    "defaults"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "main": "bundles/redoc.js",
  "module": "bundles/redoc.js",
  "types": "bundles/redoc.d.ts",
  "author": "Roman Hotsiy <gotsijroman@gmail.com>",
  "keywords": [
    "OpenAPI",
    "OpenAPI Specification",
    "AsyncAPI",
    "GraphQL",
    "Swagger",
    "JSON-Schema",
    "API",
    "REST",
    "documentation",
    "React.js"
  ],
  "license": "MIT",
  "workspaces": [
    "."
  ],
  "files": [
    "bundles",
    "typings",
    "LICENSE.md",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "start": "vite",
    "build": "npm run build:artifacts && npm run minify",
    "build:artifacts": "npm run clean && npm run ts:check && npm run build:lib && npm run build:standalone",
    "build:lib": "vite build && npm run check:node && npm run ts:dts",
    "check:node": "node --input-type=module -e \"await import('./bundles/redoc.js')\"",
    "build:standalone": "vite build --mode standalone",
    "analyze:bundle": "vite build --mode analyze",
    "minify": "node scripts/minify.js bundles",
    "unit": "vitest run",
    "unit:update": "vitest run -u",
    "unit:watch": "vitest",
    "unit:coverage": "vitest run --coverage",
    "unit:coverage:html": "vitest run --coverage --coverage.reporter=html",
    "e2e:build": "npm run build:lib && npm run build:standalone && vite build --config e2e/vite.config.ts && vite build --config e2e/playwright/ce/react-host/vite.config.ts && node e2e/playwright/ce/prepare-host.mjs",
    "e2e": "npm run e2e:build && npx playwright test --config e2e/playwright.config.ts",
    "e2e:ui": "npx playwright test --config e2e/playwright.config.ts --ui",
    "e2e:start": "vite --config e2e/vite.config.ts",
    "test:examples": "npx playwright test --config e2e/playwright.examples.config.ts",
    "test": "npm run lint && npm run ts:check && npm run unit && npm run e2e",
    "lint": "oxlint --max-warnings=0",
    "lint:fix": "oxlint --fix",
    "ts:check": "tsgo --noEmit --skipLibCheck && tsgo -p e2e/tsconfig.json",
    "ts:dts": "tsgo -p tsconfig.build.json --emitDeclarationOnly && api-extractor run --local --verbose && api-extractor run --local --verbose --config api-extractor.standalone.json",
    "clean": "rimraf bin bundles typings",
    "clear:cache": "scripts/clear-cache.sh",
    "pack:sourcemaps": "npm run build:artifacts && node scripts/minify.js bundles --sourcemaps && find bundles -name \"*.js.map\" -print0 | tar -czvf redoc.sourcemaps.tar.gz --null -T -",
    "list:licenses": "node ./scripts/list-licenses.js",
    "license:check": "license-checker --production --onlyAllow 'MIT;ISC;Apache-2.0;BSD;BSD-2-Clause;BSD-3-Clause;CC-BY-4.0;CC0-1.0;Python-2.0' --summary",
    "changeset": "changeset",
    "release": "npm run build && changeset publish --tag next",
    "publish-cdn": "scripts/publish-cdn.sh"
  },
  "peerDependencies": {
    "@redocly/config": "^0.59.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "styled-components": "^6.0.0"
  },
  "dependencies": {
    "@markdoc/markdoc": "0.5.2",
    "@redocly/ajv": "8.18.0",
    "@redocly/allof-merge": "^0.6.9",
    "@redocly/config": "^0.59.0",
    "@redocly/openapi-core": "2.55.0",
    "@redocly/redoc-opentelemetry": "^0.5.0",
    "@redocly/theme": "0.70.0-next.3",
    "@types/json-schema": "^7.0.15",
    "dompurify": "^3.4.11",
    "fast-xml-parser": "^5.5.9",
    "flexsearch": "^0.8.2",
    "graphql": "^16.11.0",
    "jotai": "^2.12.5",
    "jotai-family": "^1.0.1",
    "json-pointer": "^0.6.2",
    "linkedom": "^0.18.9",
    "openapi-sampler": "^1.7.5",
    "prismjs": "1.30.0",
    "react-router": "^8.3.0",
    "slugify": "^1.4.4",
    "swagger2openapi": "^7.0.8",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@microsoft/api-extractor": "7.58.2",
    "@playwright/test": "1.60.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/json-pointer": "1.0.34",
    "@types/node": "24.1.0",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "beta",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "http-server": "14.1.1",
    "jest-styled-components": "7.2.0",
    "js-yaml": "^5.2.2",
    "jsdom": "^25.0.1",
    "license-checker": "25.0.1",
    "oxlint": "1.67.0",
    "path-browserify": "1.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rimraf": "5.0.10",
    "rolldown": "^1.2.4",
    "rollup-plugin-bundle-stats": "^4.22.1",
    "styled-components": "^6.5.3",
    "typescript": "5.9.3",
    "url": "0.11.4",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
