{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node"],
    // Type-check only, so the inherited emit settings do not apply. rootDir is the package
    // root because src/api.ce.ts reaches into the engine source alongside this directory.
    "rootDir": "..",
    "composite": false,
    "declaration": false
  },
  // Scoped to what this package authors; the synced specs are not type-checked by the
  // enterprise config either. The engine's ambient declarations come along because src/api.ce.ts
  // imports its source.
  "include": [
    "./src/**/*",
    "./vite.config.ts",
    "./playwright.examples.config.ts",
    "./playwright/ce/**/*",
    "../src/**/*.d.ts"
  ],
  // Artifacts staged into playwright/ce by prepare-host, not sources.
  "exclude": ["dist", "playwright/ce/bundles", "playwright/ce/react", "playwright/ce/specs"]
}
