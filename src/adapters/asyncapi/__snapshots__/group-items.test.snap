                            - EMAIL
                            - SMS
                          description: Delivery channel for the promotion
                    externalDocs:
                      url: https://developer.wheelyfast.io/docs/promotions
                      description: Promotion targeting documentation
                pointer: channels/passenger-notifications/messages
            panels:
              - children:
                  - kind: payload
                    panelLabel: Value
                    exampleIds:
                      - example_8
                      - example_9
                    schemaId: components/messages/driverArrival/payload
                    examples:
