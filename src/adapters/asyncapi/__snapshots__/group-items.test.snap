          - nodeType: container
            children:
              - nodeType: header
                level: 2
                label: Passenger Notification Topic
                showPageActions: true
                protocolTag:
                  label: Topic
                  color: topic
              - nodeType: channel-address
                address: passenger-notifications-{type}
              - nodeType: markdoc
                content: Event stream of notifications directed to passengers
              - nodeType: markdoc
                content: >-
                  Topic for delivering various types of notifications to passengers including driver arrivals and
                  promotional offers.
              - nodeType: header
                level: 4
                label: Parameters
                labelTranslationKey: parameters
                deepLinkSuffix: parameters
