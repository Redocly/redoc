- label: Ride Requests Topic
  type: group
  link: docs/asyncapi/rides/topics/ride-requests
  routeSlug: docs/asyncapi/rides/topics/ride-requests
  badges: []
  httpVerb: topic
  metadata:
    seo:
      title: Ride Requests Topic
      description: >-
        Primary topic for all ride requests submitted by passengers through the WheelyFast mobile app. This critical
        topic handles the initial request flow, including new ride requests and any subsequent cancellations before a
        driver has been matched.
  content:
    contentType: item
    itemVariant: channel
    meta:
      name: Ride Requests Topic
      pointer: /channels/ride-requests
      protocolTag:
        label: Topic
        color: topic
    seo:
      title: Ride Requests Topic
      description: |-
        Primary topic for all ride requests submitted by passengers through the WheelyFast mobile app.
        This critical topic handles the initial request flow, including new ride requests and any subsequent
        cancellations before a driver has been matched.
    children:
      - nodeType: container
        children:
          - nodeType: header
            level: 2
            label: Ride Requests Topic
            showPageActions: true
            protocolTag:
              label: Topic
              color: topic
          - nodeType: channel-address
            address: ride-requests-{region}
          - nodeType: markdoc
            content: Stream of passenger ride requests and cancellations events
          - nodeType: markdoc
            content: |-
              Primary topic for all ride requests submitted by passengers through the WheelyFast mobile app.
              This critical topic handles the initial request flow, including new ride requests and any subsequent
              cancellations before a driver has been matched.
          - nodeType: external-docs
            url: https://developer.wheelyfast.io/docs/ride-requests
            description: Documentation for ride request processing flow
          - nodeType: header
            level: 4
            label: Parameters
            labelTranslationKey: parameters
            deepLinkSuffix: parameters
          - nodeType: item-content
            variant: parameters
            parameters:
              - name: region
                in: path
                schemaId: schema_0
                description: Geographic region for the ride requests
            pointer: channels/ride-requests/parameters
        panels:
          - children:
              - kind: brokers
                panelLabel: Brokers
                brokers:
                  - name: production
                    url: kafka.wheelyfast.io:9092
                    description: Production Kafka broker cluster
                    protocol: kafka
                    protocolVersion: 2.6.0
                    pathname: /
                    title: Production WheelyFast Kafka Brokers
                    summary: Main production messaging brokers for the WheelyFast platform
                    bindings:
                      kafka:
                        schemaRegistryUrl: https://registry.wheelyfast.io
                        schemaRegistryVendor: confluent
                    variables:
                      region:
                        description: Geographic region for the broker cluster
                        default: us-east-1
                        enum:
                          - us-east-1
                          - us-west-2
                          - eu-central-1
                      environment:
                        description: Deployment environment
                        default: production
          - title: Topic configuration
            children:
              - kind: channel-binding
                panelLabel: Topic configuration
                bindingKey: kafka
                bindingValue:
                  topic: ride-requests-{region}
                  partitions: 10
                  replicas: 3
                  topicConfiguration:
                    cleanup.policy:
                      - delete
                    retention.ms: 604800000
                    retention.bytes: 1073741824
                    delete.retention.ms: 86400000
                    max.message.bytes: 1048576
                  bindingVersion: 0.4.0
      - nodeType: container
        children:
          - nodeType: header
            level: 4
            label: Messages
            labelTranslationKey: messages
            deepLinkSuffix: messages
          - nodeType: item-content
            variant: messages
            messages:
              - name: requestRide
                label: Ride Request
                summary: A passenger requests a new ride with pickup and destination locations
                description: Core message that initiates the ride flow with all necessary details to match with a driver.
                schemaId: components/messages/requestRide/payload
                headerSchemaId: components/messages/requestRide/headers
                exampleIds:
                  - example_0
                  - example_1
                payload:
                  $ref: '#/components/schemas/RideRequest'
                payloadLabel: Value
                headers:
                  type: object
                  properties:
                    requestId:
                      type: string
                      format: uuid
                      description: Unique identifier for tracking the request across services
                    timestamp:
                      type: string
                      format: date-time
                      description: Time when the request was generated
                externalDocs:
                  url: https://developer.wheelyfast.io/docs/messages/ride-request
                  description: Technical details about ride request payload structure
              - name: cancelRideRequest
                label: Ride Request Cancellation
                summary: A passenger cancels a previously submitted ride request
                description: Cancellation message for a ride that hasn't been accepted by a driver yet, including reason data.
                schemaId: components/messages/cancelRideRequest/payload
                payload:
                  $ref: '#/components/schemas/RideRequestCancellation'
                payloadLabel: Value
            pointer: channels/ride-requests/messages
        panels:
          - children:
              - kind: payload
                panelLabel: Value
                exampleIds:
                  - example_0
                  - example_1
                schemaId: components/messages/requestRide/payload
                examples:
                  - {}
                  - {}
                messagesByKey:
                  requestRide:
                    schemaId: components/messages/requestRide/payload
                    exampleIds:
                      - example_0
                      - example_1
                  cancelRideRequest:
                    schemaId: components/messages/cancelRideRequest/payload
          - title: Message configuration
            children:
              - kind: message-binding
                bindingsByMessageKey:
                  requestRide:
                    bindingKey: kafka
                    bindingValue:
                      key:
                        type: string
                        description: Passenger ID
                      schemaIdLocation: value
                      schemaIdPayloadEncoding: confluent
                      bindingVersion: 0.4.0
                    keySchemaId: schema_1
                  cancelRideRequest:
                    bindingKey: kafka
                    bindingValue:
                      key:
                        type: string
                        description: Request ID
                      schemaIdLocation: value
                      schemaIdPayloadEncoding: confluent
                      bindingVersion: 0.4.0
                    keySchemaId: schema_2
  items:
    - label: Produce Ride Request
      type: link
      link: docs/asyncapi/rides/topics/ride-requests/operations/publishriderequest
      routeSlug: docs/asyncapi/rides/topics/ride-requests/operations/publishriderequest
      httpVerb: pub
      badges: []
      metadata:
        seo:
          title: Produce Ride Request
          description: Produces event with pickup/dropoff locations and preferences. Starting point for the matching process.
      content:
        contentType: item
        itemVariant: channelOperation
        meta:
          name: Produce Ride Request
          pointer: /operations/publishRideRequest
          protocolTag:
            label: Pub
            color: send
          action: send
          actionLabel: Publish
          channelBindings:
            kafka:
              topic: ride-requests-{region}
              partitions: 10
              replicas: 3
              topicConfiguration:
                cleanup.policy:
                  - delete
                retention.ms: 604800000
                retention.bytes: 1073741824
                delete.retention.ms: 86400000
                max.message.bytes: 1048576
              bindingVersion: 0.4.0
        seo:
          title: Produce Ride Request
          description: Produces event with pickup/dropoff locations and preferences. Starting point for the matching process.
        children:
          - nodeType: container
            children:
              - nodeType: header
                level: 4
                label: Publish
              - nodeType: header
                level: 5
                label: Produce Ride Request
                badges: []
                showPageActions: true
                protocolTag:
                  label: Pub
                  color: send
              - nodeType: markdoc
                content: Passenger app produces a new ride request event
              - nodeType: markdoc
                content: Produces event with pickup/dropoff locations and preferences. Starting point for the matching process.
              - nodeType: message-links
                channelLink: /rides/topics/ride-requests
                messages:
                  - name: requestRide
                    label: Ride Request
            panels:
              - title: Operation configuration
                children:
                  - kind: operation-binding
                    bindingKey: kafka
                    bindingValue:
                      bindingVersion: 0.4.0
                      clientId:
                        type: string
                        description: Passenger app client identifier
                        default: passenger-app
                      groupId:
                        type: string
                        description: Ride request producer group
                        default: ride-request-producer
                    groupIdSchemaId: schema_3
                    clientIdSchemaId: schema_4
          - nodeType: container
            children:
              - nodeType: feedback
                pageSlug: /rides/topics/ride-requests/operations/publishriderequest
            panels: []
        showDivider: true
    - label: Produce Ride Cancellation
      type: link
      link: docs/asyncapi/rides/topics/ride-requests/operations/cancelriderequest
      routeSlug: docs/asyncapi/rides/topics/ride-requests/operations/cancelriderequest
      httpVerb: pub
      badges: []
      metadata:
        seo:
          title: Produce Ride Cancellation
          description: Allows cancellation of unmatched ride requests with reason tracking for analytics.
      content:
        contentType: item
        itemVariant: channelOperation
        meta:
          name: Produce Ride Cancellation
          pointer: /operations/cancelRideRequest
          protocolTag:
            label: Pub
            color: send
          action: send
          actionLabel: Publish
          channelBindings:
            kafka:
              topic: ride-requests-{region}
              partitions: 10
              replicas: 3
              topicConfiguration:
                cleanup.policy:
                  - delete
                retention.ms: 604800000
                retention.bytes: 1073741824
                delete.retention.ms: 86400000
                max.message.bytes: 1048576
              bindingVersion: 0.4.0
        seo:
          title: Produce Ride Cancellation
          description: Allows cancellation of unmatched ride requests with reason tracking for analytics.
        children:
          - nodeType: container
            children:
              - nodeType: header
                level: 5
                label: Produce Ride Cancellation
                badges: []
                showPageActions: true
                protocolTag:
                  label: Pub
                  color: send
              - nodeType: markdoc
                content: Passenger produces a cancellation event before driver assignment
              - nodeType: markdoc
                content: Allows cancellation of unmatched ride requests with reason tracking for analytics.
              - nodeType: message-links
                channelLink: /rides/topics/ride-requests
                messages:
                  - name: cancelRideRequest
                    label: Ride Request Cancellation
            panels:
              - title: Operation configuration
                children:
                  - kind: operation-binding
                    bindingKey: kafka
                    bindingValue:
                      bindingVersion: 0.4.0
                      clientId:
                        type: string
                        description: Passenger app client identifier
                        default: passenger-app
                      groupId:
                        type: string
                        description: Ride cancellation producer group
                        default: ride-cancellation-producer
                    groupIdSchemaId: schema_5
                    clientIdSchemaId: schema_4
          - nodeType: container
            children:
              - nodeType: feedback
                pageSlug: /rides/topics/ride-requests/operations/cancelriderequest
            panels: []
        showDivider: true
    - label: Consume Ride Requests
      type: link
      link: docs/asyncapi/rides/topics/ride-requests/operations/receiveriderequest
      routeSlug: docs/asyncapi/rides/topics/ride-requests/operations/receiveriderequest
      httpVerb: sub
      badges: []
      metadata:
        seo:
          title: Consume Ride Requests
          description: >-
            Core consumer service that processes request events to find optimal driver matches based on proximity and
            other factors.
      content:
        contentType: item
        itemVariant: channelOperation
        meta:
          name: Consume Ride Requests
          pointer: /operations/receiveRideRequest
          protocolTag:
            label: Sub
            color: receive
          action: receive
          actionLabel: Subscribe
          channelBindings:
            kafka:
              topic: ride-requests-{region}
              partitions: 10
              replicas: 3
              topicConfiguration:
                cleanup.policy:
                  - delete
                retention.ms: 604800000
                retention.bytes: 1073741824
                delete.retention.ms: 86400000
                max.message.bytes: 1048576
              bindingVersion: 0.4.0
        seo:
          title: Consume Ride Requests
          description: >-
            Core consumer service that processes request events to find optimal driver matches based on proximity and
            other factors.
        children:
          - nodeType: container
            children:
              - nodeType: header
                level: 4
                label: Subscribe
              - nodeType: header
                level: 5
                label: Consume Ride Requests
                badges: []
                showPageActions: true
                protocolTag:
                  label: Sub
                  color: receive
              - nodeType: markdoc
                content: Matching service consumes ride request events from topic
              - nodeType: markdoc
                content: >-
                  Core consumer service that processes request events to find optimal driver matches based on proximity
                  and other factors.
              - nodeType: message-links
                channelLink: /rides/topics/ride-requests
                messages:
                  - name: requestRide
                    label: Ride Request
            panels:
              - title: Operation configuration
                children:
                  - kind: operation-binding
                    bindingKey: kafka
                    bindingValue:
                      bindingVersion: 0.4.0
                      clientId:
                        type: string
                        description: Matching service client identifier
                        default: matching-service
                      groupId:
                        type: string
                        description: Matching service consumer group
                        enum:
                          - WheelyFast-Matcher
                    groupIdSchemaId: schema_6
                    clientIdSchemaId: schema_7
          - nodeType: container
            children:
              - nodeType: feedback
                pageSlug: /rides/topics/ride-requests/operations/receiveriderequest
            panels: []
        showDivider: false
- label: Ride Matching Topic
  type: group
  link: docs/asyncapi/rides/topics/ride-matches
  routeSlug: docs/asyncapi/rides/topics/ride-matches
  badges: []
  httpVerb: topic
  metadata:
    seo:
      title: Ride Matching Topic
      description: >-
        Critical topic handling the matching of passenger ride requests to available drivers. Contains both successful
        matches and declined match events to enable proper ride assignment and provide insights into driver preferences
        and matching efficiency.
  content:
    contentType: item
    itemVariant: channel
    meta:
      name: Ride Matching Topic
      pointer: /channels/ride-matches
      protocolTag:
        label: Topic
        color: topic
    seo:
      title: Ride Matching Topic
      description: |-
        Critical topic handling the matching of passenger ride requests to available drivers.
        Contains both successful matches and declined match events to enable proper ride assignment
        and provide insights into driver preferences and matching efficiency.
    children:
      - nodeType: container
        children:
          - nodeType: header
            level: 2
            label: Ride Matching Topic
            showPageActions: true
            protocolTag:
              label: Topic
              color: topic
          - nodeType: channel-address
            address: ride-matches-{region}
          - nodeType: markdoc
            content: Event stream of ride-to-driver match events
          - nodeType: markdoc
            content: |-
              Critical topic handling the matching of passenger ride requests to available drivers.
              Contains both successful matches and declined match events to enable proper ride assignment
              and provide insights into driver preferences and matching efficiency.
          - nodeType: header
            level: 4
            label: Parameters
            labelTranslationKey: parameters
            deepLinkSuffix: parameters
          - nodeType: item-content
            variant: parameters
            parameters:
              - name: region
                in: path
                schemaId: schema_8
                description: Geographic region for the ride matches
            pointer: channels/ride-matches/parameters
        panels:
          - children:
              - kind: brokers
                panelLabel: Brokers
                brokers:
                  - name: staging
                    url: staging-kafka.wheelyfast.io:9092
                    description: Staging Kafka broker cluster for pre-production testing
                    protocol: kafka
                    protocolVersion: 2.6.0
                    pathname: /
                    title: Staging WheelyFast Kafka Brokers
                    summary: Pre-production messaging brokers for testing and verification
                    bindings:
                      kafka:
                        schemaRegistryUrl: https://staging-registry.wheelyfast.io
                        schemaRegistryVendor: confluent
                    variables:
                      region:
                        description: Geographic region for the broker cluster
                        default: us-east-1
                        enum:
                          - us-east-1
                          - us-west-2
                      environment:
                        description: Deployment environment
                        default: staging
          - title: Topic configuration
            children:
              - kind: channel-binding
                panelLabel: Topic configuration
                bindingKey: kafka
                bindingValue:
                  topic: ride-matches-{region}
                  partitions: 8
                  replicas: 3
                  topicConfiguration:
                    cleanup.policy:
                      - delete
                      - compact
                    retention.ms: 259200000
                    retention.bytes: 536870912
                    delete.retention.ms: 86400000
                    max.message.bytes: 1048576
                  bindingVersion: 0.4.0
      - nodeType: container
        children:
          - nodeType: header
            level: 4
            label: Messages
            labelTranslationKey: messages
            deepLinkSuffix: messages
          - nodeType: item-content
            variant: messages
            messages:
              - name: driverMatch
                label: Driver Match
                summary: Notification of a successful match between driver and ride request
                description: Contains details about the matched driver, vehicle, and estimated arrival time for the passenger.
                schemaId: components/messages/driverMatch/payload
                headerSchemaId: components/messages/driverMatch/headers
                exampleIds:
                  - example_2
                  - example_3
                payload:
                  $ref: '#/components/schemas/DriverMatch'
                payloadLabel: Value
                headers:
                  type: object
                  properties:
                    matchId:
                      type: string
                      format: uuid
                      description: Unique identifier for this specific driver-to-ride match
                    processingTimeMs:
                      type: integer
                      description: Time taken to compute the match in milliseconds
                      example: 235
                externalDocs:
                  url: https://developer.wheelyfast.io/docs/matching-algorithm
                  description: Driver matching algorithm details
              - name: matchDeclined
                label: Match Declined
                summary: Driver has declined a proposed ride match
                description: Sent when a driver chooses not to accept a matched ride request, with decline reason.
                schemaId: components/messages/matchDeclined/payload
                payload:
                  $ref: '#/components/schemas/MatchDeclined'
                payloadLabel: Value
            pointer: channels/ride-matches/messages
        panels:
          - children:
              - kind: payload
                panelLabel: Value
                exampleIds:
                  - example_2
                  - example_3
                schemaId: components/messages/driverMatch/payload
                examples:
                  - {}
                  - {}
                messagesByKey:
                  driverMatch:
                    schemaId: components/messages/driverMatch/payload
                    exampleIds:
                      - example_2
                      - example_3
                  matchDeclined:
                    schemaId: components/messages/matchDeclined/payload
          - title: Message configuration
            children:
              - kind: message-binding
                bindingsByMessageKey:
                  driverMatch:
                    bindingKey: kafka
                    bindingValue:
                      key:
                        type: string
                        description: Request ID
                      schemaIdLocation: value
                      schemaIdPayloadEncoding: confluent
                      bindingVersion: 0.4.0
                    keySchemaId: schema_2
                  matchDeclined:
                    bindingKey: kafka
                    bindingValue:
                      key:
                        type: string
                        description: Match ID
                      schemaIdLocation: value
                      schemaIdPayloadEncoding: confluent
                      bindingVersion: 0.4.0
                    keySchemaId: schema_9
  items:
    - label: Produce Driver Match
      type: link
      link: docs/asyncapi/rides/topics/ride-matches/operations/publishdrivermatch
      routeSlug: docs/asyncapi/rides/topics/ride-matches/operations/publishdrivermatch
      httpVerb: pub
      badges: []
      metadata:
        seo:
          title: Produce Driver Match
          description: >-
            Produces driver-to-passenger match events when optimal driver is identified. Critical connection point in
            the ride lifecycle.
      content:
        contentType: item
        itemVariant: channelOperation
        meta:
          name: Produce Driver Match
          pointer: /operations/publishDriverMatch
          protocolTag:
            label: Pub
            color: send
          action: send
          actionLabel: Publish
          channelBindings:
            kafka:
              topic: ride-matches-{region}
              partitions: 8
              replicas: 3
              topicConfiguration:
                cleanup.policy:
                  - delete
                  - compact
                retention.ms: 259200000
                retention.bytes: 536870912
                delete.retention.ms: 86400000
                max.message.bytes: 1048576
              bindingVersion: 0.4.0
        seo:
          title: Produce Driver Match
          description: >-
            Produces driver-to-passenger match events when optimal driver is identified. Critical connection point in
            the ride lifecycle.
        children:
          - nodeType: container
            children:
              - nodeType: header
                level: 4
                label: Publish
              - nodeType: header
                level: 5
                label: Produce Driver Match
                badges: []
                showPageActions: true
                protocolTag:
                  label: Pub
                  color: send
              - nodeType: markdoc
                content: Matching service produces driver-passenger match events
              - nodeType: markdoc
                content: >-
                  Produces driver-to-passenger match events when optimal driver is identified. Critical connection point
                  in the ride lifecycle.
              - nodeType: message-links
                channelLink: /rides/topics/ride-matches
                messages:
                  - name: driverMatch
                    label: Driver Match
            panels:
              - title: Operation configuration
                children:
                  - kind: operation-binding
                    bindingKey: kafka
                    bindingValue:
                      bindingVersion: 0.4.0
                      clientId:
                        type: string
                        description: Matching service client identifier
                        default: matching-service
                      groupId:
                        type: string
                        description: Driver match producer group
                        default: driver-match-producer
                    groupIdSchemaId: schema_10
                    clientIdSchemaId: schema_7
          - nodeType: container
            children:
              - nodeType: feedback
                pageSlug: /rides/topics/ride-matches/operations/publishdrivermatch
            panels: []
        showDivider: true
    - label: Consume Driver Match Events
      type: link
      link: docs/asyncapi/rides/topics/ride-matches/operations/receivedrivermatch
      routeSlug: docs/asyncapi/rides/topics/ride-matches/operations/receivedrivermatch
      httpVerb: sub
      badges: []
      metadata:
        seo:
          title: Consume Driver Match Events
          description: >-
            Displays ride details to driver for acceptance or rejection within set timeframe. Time-sensitive event
            consumption for continuing ride flow.
      content:
        contentType: item
        itemVariant: channelOperation
        meta:
          name: Consume Driver Match Events
          pointer: /operations/receiveDriverMatch
          protocolTag:
            label: Sub
            color: receive
          action: receive
          actionLabel: Subscribe
          channelBindings:
            kafka:
              topic: ride-matches-{region}
              partitions: 8
              replicas: 3
              topicConfiguration:
                cleanup.policy:
                  - delete
                  - compact
                retention.ms: 259200000
                retention.bytes: 536870912
                delete.retention.ms: 86400000
                max.message.bytes: 1048576
              bindingVersion: 0.4.0
        seo:
          title: Consume Driver Match Events
          description: >-
            Displays ride details to driver for acceptance or rejection within set timeframe. Time-sensitive event
            consumption for continuing ride flow.
        children:
          - nodeType: container
            children:
              - nodeType: header
                level: 4
                label: Subscribe
              - nodeType: header
                level: 5
                label: Consume Driver Match Events
                badges: []
                showPageActions: true
                protocolTag:
                  label: Sub
                  color: receive
              - nodeType: markdoc
                content: Driver app consumes match events and presents ride opportunities
              - nodeType: markdoc
                content: >-
                  Displays ride details to driver for acceptance or rejection within set timeframe. Time-sensitive event
                  consumption for continuing ride flow.
              - nodeType: message-links
                channelLink: /rides/topics/ride-matches
                messages:
                  - name: driverMatch
                    label: Driver Match
            panels:
              - title: Operation configuration
                children:
                  - kind: operation-binding
                    bindingKey: kafka
                    bindingValue:
                      bindingVersion: 0.4.0
                      clientId:
                        type: string
                        description: Driver app client identifier
                        default: driver-app
                      groupId:
                        type: string
                        description: Driver match consumer group
                        default: driver-match-consumer
                    groupIdSchemaId: schema_11
                    clientIdSchemaId: schema_12
          - nodeType: container
            children:
              - nodeType: feedback
                pageSlug: /rides/topics/ride-matches/operations/receivedrivermatch
            panels: []
        showDivider: false
- label: Ride Status Topic
  type: group
  link: docs/asyncapi/rides/topics/ride-status
  routeSlug: docs/asyncapi/rides/topics/ride-status
  badges: []
  httpVerb: topic
  metadata:
    seo:
      title: Ride Status Topic
      description: >-
        Comprehensive topic tracking the lifecycle of all rides from start to completion or cancellation. Critical for
        tracking ride progress, generating metrics, and maintaining an audit trail of service delivery.
  content:
    contentType: item
    itemVariant: channel
    meta:
      name: Ride Status Topic
      pointer: /channels/ride-status
      protocolTag:
        label: Topic
        color: topic
    seo:
      title: Ride Status Topic
      description: |-
        Comprehensive topic tracking the lifecycle of all rides from start to completion or cancellation.
        Critical for tracking ride progress, generating metrics, and maintaining an audit trail of service delivery.
    children:
      - nodeType: container
        children:
          - nodeType: header
            level: 2
            label: Ride Status Topic
            showPageActions: true
            protocolTag:
              label: Topic
              color: topic
          - nodeType: channel-address
            address: ride-status-{environment}-{rideId}
          - nodeType: markdoc
            content: Event stream of status updates for all active rides
          - nodeType: markdoc
            content: >-
              Comprehensive topic tracking the lifecycle of all rides from start to completion or cancellation.

              Critical for tracking ride progress, generating metrics, and maintaining an audit trail of service
              delivery.
          - nodeType: header
            level: 4
            label: Parameters
            labelTranslationKey: parameters
            deepLinkSuffix: parameters
          - nodeType: item-content
            variant: parameters
            parameters:
              - name: rideId
                in: path
                schemaId: schema_13
                description: Unique identifier for a specific ride
              - name: environment
                in: path
                schemaId: schema_14
                description: Deployment environment for the ride status
            pointer: channels/ride-status/parameters
        panels:
          - children:
              - kind: brokers
                panelLabel: Brokers
                brokers:
                  - name: production
                    url: kafka.wheelyfast.io:9092
                    description: Production Kafka broker cluster
                    protocol: kafka
                    protocolVersion: 2.6.0
                    pathname: /
                    title: Production WheelyFast Kafka Brokers
                    summary: Main production messaging brokers for the WheelyFast platform
                    bindings:
                      kafka:
                        schemaRegistryUrl: https://registry.wheelyfast.io
                        schemaRegistryVendor: confluent
                    variables:
                      region:
                        description: Geographic region for the broker cluster
