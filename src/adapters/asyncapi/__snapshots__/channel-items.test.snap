            level: 4
            label: Messages
            labelTranslationKey: messages
            deepLinkSuffix: messages
          - nodeType: item-content
            variant: messages
            messages:
              - name: paymentAuthorized
                label: Payment Authorized
                summary: Pre-authorization hold placed on passenger's payment method
                description: >-
                  Confirms a payment method has been authorized before ride begins. Contains authorization details and
                  amount.
                schemaId: components/messages/paymentAuthorized/payload
                payload:
                  $ref: '#/components/schemas/PaymentAuthorized'
                payloadLabel: Value
                externalDocs:
                  url: https://developer.wheelyfast.io/docs/payments
                  description: Payment processing flows
              - name: paymentCompleted
                label: Payment Completed
                summary: Final payment has been successfully processed
                description: >-
                  Confirms successful charge to passenger's payment method. Includes final amount, tip, and transaction
                  details.
                schemaId: components/messages/paymentCompleted/payload
                headerSchemaId: components/messages/paymentCompleted/headers
                exampleIds:
                  - example_6
                  - example_7
                payload:
                  $ref: '#/components/schemas/PaymentCompleted'
                payloadLabel: Value
                headers:
                  type: object
                  properties:
                    transactionId:
                      type: string
                      format: uuid
                      description: Unique identifier for the payment transaction
                    paymentGateway:
                      type: string
                      description: Payment processor that handled the transaction
                      example: STRIPE
              - name: paymentFailed
                label: Payment Failed
                summary: Payment processing failed with an error
                description: Indicates a payment attempt was unsuccessful. Contains error code and details for resolution.
                schemaId: components/messages/paymentFailed/payload
                payload:
                  $ref: '#/components/schemas/PaymentFailed'
                payloadLabel: Value
            pointer: channels/paymentsProcessing/messages
        panels:
          - children:
              - kind: payload
                panelLabel: Value
                exampleIds:
                  - example_6
                  - example_7
                schemaId: components/messages/paymentAuthorized/payload
                examples:
                  - {}
                  - {}
                messagesByKey:
                  paymentAuthorized:
                    schemaId: components/messages/paymentAuthorized/payload
                  paymentCompleted:
                    schemaId: components/messages/paymentCompleted/payload
                    exampleIds:
                      - example_6
                      - example_7
                  paymentFailed:
                    schemaId: components/messages/paymentFailed/payload
          - title: Message configuration
            children:
              - kind: message-binding
                bindingsByMessageKey:
                  paymentAuthorized:
                    bindingKey: kafka
                    bindingValue:
                      key:
                        type: string
                        description: Ride ID
                      schemaIdLocation: value
                      schemaIdPayloadEncoding: confluent
                      bindingVersion: 0.4.0
                    keySchemaId: schema_15
                  paymentCompleted:
                    bindingKey: kafka
                    bindingValue:
                      key:
                        type: string
                        description: Ride ID
                      schemaIdLocation: value
                      schemaIdPayloadEncoding: confluent
                      bindingVersion: 0.4.0
                    keySchemaId: schema_15
                  paymentFailed:
                    bindingKey: kafka
                    bindingValue:
                      key:
                        type: string
                        description: Ride ID
                      schemaIdLocation: value
                      schemaIdPayloadEncoding: confluent
                      bindingVersion: 0.4.0
                    keySchemaId: schema_15
