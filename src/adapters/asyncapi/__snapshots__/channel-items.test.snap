                    description: Staging Kafka broker cluster for pre-production testing
                    protocol: kafka
                    protocolVersion: 2.6.0
                    pathname: /
                    title: Staging WheelyFast Kafka Brokers
                    summary: Pre-production messaging brokers for testing and verification
                    bindings:
                      kafka:
                        schemaRegistryUrl: https://staging-registry.wheelyfast.io
                        schemaRegistryVendor: confluent
                    variables:
                      region:
                        description: Geographic region for the broker cluster
                        default: us-east-1
                        enum:
                          - us-east-1
                          - us-west-2
                      environment:
                        description: Deployment environment
                        default: staging
          - title: Topic configuration
            children:
              - kind: channel-binding
                panelLabel: Topic configuration
                bindingKey: kafka
                bindingValue:
                  topic: passenger-notifications-{type}
                  partitions: 10
                  replicas: 3
                  topicConfiguration:
                    cleanup.policy:
                      - delete
                    retention.ms: 86400000
                    retention.bytes: 536870912
                    delete.retention.ms: 86400000
                    max.message.bytes: 1048576
                  bindingVersion: 0.4.0
      - nodeType: container
        children:
          - nodeType: header
            level: 4
            label: Messages
            labelTranslationKey: messages
            deepLinkSuffix: messages
          - nodeType: item-content
            variant: messages
            messages:
              - name: driverArrival
                label: Driver Arrival Notification
                summary: Alert that driver is approaching pickup location
                description: >-
                  Notifies passenger that their driver is arriving at the pickup point. Includes current location and
                  ETA.
                schemaId: components/messages/driverArrival/payload
                payload:
                  $ref: '#/components/schemas/DriverArrival'
                payloadLabel: Value
              - name: promotionNotification
                label: Promotion Notification
                summary: Marketing message about available promotions or discounts
                description: >-
                  Delivers targeted promotional offers to passengers. Includes discount details and expiration
                  information.
                schemaId: components/messages/promotionNotification/payload
                headerSchemaId: components/messages/promotionNotification/headers
                exampleIds:
                  - example_8
                  - example_9
                payload:
                  $ref: '#/components/schemas/PromotionNotification'
                payloadLabel: Value
                headers:
                  type: object
                  properties:
                    campaignId:
                      type: string
                      description: Unique identifier for the marketing campaign
                    marketingChannel:
                      type: string
                      enum:
                        - IN_APP
                        - PUSH
                        - EMAIL
                        - SMS
                      description: Delivery channel for the promotion
                externalDocs:
                  url: https://developer.wheelyfast.io/docs/promotions
                  description: Promotion targeting documentation
            pointer: channels/passenger-notifications/messages
        panels:
          - children:
              - kind: payload
                panelLabel: Value
                exampleIds:
                  - example_8
                  - example_9
                schemaId: components/messages/driverArrival/payload
                examples:
                  - {}
                  - {}
                messagesByKey:
                  driverArrival:
                    schemaId: components/messages/driverArrival/payload
                  promotionNotification:
                    schemaId: components/messages/promotionNotification/payload
                    exampleIds:
                      - example_8
                      - example_9
          - title: Message configuration
            children:
              - kind: message-binding
                bindingsByMessageKey:
                  driverArrival:
                    bindingKey: kafka
                    bindingValue:
                      key:
                        type: string
                        description: Passenger ID
                      schemaIdLocation: value
                      schemaIdPayloadEncoding: confluent
                      bindingVersion: 0.4.0
                    keySchemaId: schema_1
                  promotionNotification:
                    bindingKey: kafka
                    bindingValue:
                      key:
                        type: string
                        description: Passenger ID
                      schemaIdLocation: value
                      schemaIdPayloadEncoding: confluent
                      bindingVersion: 0.4.0
                    keySchemaId: schema_1
- label: Driver Location Topic
  type: group
  link: docs/asyncapi/topics/driver-location
  routeSlug: docs/asyncapi/topics/driver-location
  httpVerb: topic
  badges: []
  metadata:
    seo:
      title: Driver Location Topic
      description: >-
        High-volume topic tracking the real-time location of all active drivers in the WheelyFast network. This data
        powers the matching algorithm, ETA calculations, and map visualizations.
  content:
    contentType: item
    itemVariant: channel
    meta:
      name: Driver Location Topic
      pointer: /channels/driver-location
      protocolTag:
        label: Topic
        color: topic
    seo:
      title: Driver Location Topic
      description: >-
        High-volume topic tracking the real-time location of all active drivers in the WheelyFast network. This data
        powers the matching algorithm, ETA calculations, and map visualizations.
    children:
      - nodeType: container
        children:
          - nodeType: header
            level: 2
            label: Driver Location Topic
            showPageActions: true
            protocolTag:
              label: Topic
              color: topic
          - nodeType: channel-address
            address: driver-location-{driverId}
          - nodeType: markdoc
            content: Real-time event stream of driver location coordinates
          - nodeType: markdoc
            content: >-
              High-volume topic tracking the real-time location of all active drivers in the WheelyFast network. This
              data powers the matching algorithm, ETA calculations, and map visualizations.
          - nodeType: external-docs
            url: https://developer.wheelyfast.io/docs/location-tracking
            description: Technical details about location data processing
          - nodeType: header
            level: 4
            label: Parameters
            labelTranslationKey: parameters
            deepLinkSuffix: parameters
          - nodeType: item-content
            variant: parameters
            parameters:
              - name: driverId
                in: path
                schemaId: schema_19
                description: Unique identifier for a specific driver
            pointer: channels/driver-location/parameters
        panels:
          - children:
              - kind: brokers
                panelLabel: Brokers
                brokers:
                  - name: staging
                    url: staging-kafka.wheelyfast.io:9092
                    description: Staging Kafka broker cluster for pre-production testing
                    protocol: kafka
                    protocolVersion: 2.6.0
                    pathname: /
                    title: Staging WheelyFast Kafka Brokers
                    summary: Pre-production messaging brokers for testing and verification
                    bindings:
                      kafka:
                        schemaRegistryUrl: https://staging-registry.wheelyfast.io
                        schemaRegistryVendor: confluent
                    variables:
                      region:
                        description: Geographic region for the broker cluster
                        default: us-east-1
                        enum:
                          - us-east-1
                          - us-west-2
                      environment:
                        description: Deployment environment
                        default: staging
          - title: Topic configuration
            children:
              - kind: channel-binding
                panelLabel: Topic configuration
                bindingKey: kafka
                bindingValue:
                  topic: driver-location-{driverId}
                  partitions: 20
                  replicas: 3
                  topicConfiguration:
                    cleanup.policy:
                      - delete
                    retention.ms: 43200000
                    retention.bytes: 1073741824
                    delete.retention.ms: 86400000
                    max.message.bytes: 1048576
                  bindingVersion: 0.4.0
      - nodeType: container
        children:
          - nodeType: header
            level: 4
            label: Messages
            labelTranslationKey: messages
            deepLinkSuffix: messages
          - nodeType: item-content
            variant: messages
            messages:
              - name: locationUpdate
                label: Driver Location Update
                summary: Real-time update of driver's current location
                description: >-
                  High-frequency GPS position updates sent by driver app. Critical for ETA calculations and ride
                  tracking.
                schemaId: components/messages/locationUpdate/payload
                headerSchemaId: components/messages/locationUpdate/headers
                exampleIds:
                  - example_4
                  - example_5
                payload:
                  $ref: '#/components/schemas/LocationUpdate'
                payloadLabel: Value
                headers:
                  type: object
                  properties:
                    deviceId:
                      type: string
                      description: Unique identifier for the device sending the location
                    accuracyMeters:
                      type: number
                      format: float
                      description: GPS accuracy in meters
                      example: 5.2
                externalDocs:
                  url: https://developer.wheelyfast.io/docs/location-tracking
                  description: Location tracking technical specifications
              - name: driverStatusChange
                label: Driver Status Change
                summary: Driver has changed their availability status
                description: >-
                  Indicates a driver has changed status between online, offline, busy, or on break. Affects matching
                  availability.
                schemaId: components/messages/driverStatusChange/payload
                payload:
                  $ref: '#/components/schemas/DriverStatusChange'
                payloadLabel: Value
            pointer: channels/driver-location/messages
        panels:
          - children:
              - kind: payload
                panelLabel: Value
                exampleIds:
                  - example_4
                  - example_5
                schemaId: components/messages/locationUpdate/payload
                examples:
                  - {}
                  - {}
                messagesByKey:
                  locationUpdate:
                    schemaId: components/messages/locationUpdate/payload
                    exampleIds:
                      - example_4
                      - example_5
                  driverStatusChange:
                    schemaId: components/messages/driverStatusChange/payload
          - title: Message configuration
            children:
              - kind: message-binding
                bindingsByMessageKey:
                  locationUpdate:
                    bindingKey: kafka
                    bindingValue:
                      key:
                        type: string
                        description: Driver ID
                      schemaIdLocation: value
                      schemaIdPayloadEncoding: confluent
                      bindingVersion: 0.4.0
                    keySchemaId: schema_20
                  driverStatusChange:
                    bindingKey: kafka
                    bindingValue:
                      key:
                        type: string
                        description: Driver ID
                      schemaIdLocation: value
                      schemaIdPayloadEncoding: confluent
                      bindingVersion: 0.4.0
                    keySchemaId: schema_20
  items:
    - label: Produce Location Updates
      type: link
      link: docs/asyncapi/topics/driver-location/operations/publishlocationupdates
      routeSlug: docs/asyncapi/topics/driver-location/operations/publishlocationupdates
      httpVerb: pub
      badges: []
      metadata:
        seo:
          title: Produce Location Updates
          description: >-
            High-volume event production that powers ETA calculations and ride matching algorithms. Critical for
            real-time map displays.
      content:
        contentType: item
        itemVariant: channelOperation
        meta:
          name: Produce Location Updates
          pointer: /operations/publishLocationUpdates
          protocolTag:
            label: Pub
            color: send
          action: send
          actionLabel: Publish
          channelBindings:
            kafka:
              topic: driver-location-{driverId}
              partitions: 20
              replicas: 3
              topicConfiguration:
                cleanup.policy:
                  - delete
                retention.ms: 43200000
                retention.bytes: 1073741824
                delete.retention.ms: 86400000
                max.message.bytes: 1048576
              bindingVersion: 0.4.0
        seo:
          title: Produce Location Updates
          description: >-
            High-volume event production that powers ETA calculations and ride matching algorithms. Critical for
            real-time map displays.
        children:
          - nodeType: container
            children:
              - nodeType: header
                level: 4
                label: Publish
              - nodeType: header
                level: 5
                label: Produce Location Updates
                badges: []
                showPageActions: true
                protocolTag:
                  label: Pub
                  color: send
              - nodeType: markdoc
                content: Driver app produces real-time location data events
              - nodeType: markdoc
                content: >-
                  High-volume event production that powers ETA calculations and ride matching algorithms. Critical for
                  real-time map displays.
              - nodeType: message-links
                channelLink: /topics/driver-location
                messages:
                  - name: locationUpdate
                    label: Driver Location Update
            panels:
              - title: Operation configuration
                children:
                  - kind: operation-binding
                    bindingKey: kafka
                    bindingValue:
                      bindingVersion: 0.4.0
                      clientId:
                        type: string
                        description: Driver app client identifier
                        default: driver-app
                      groupId:
                        type: string
                        description: Location updates producer group
                        default: location-update-producer
                    groupIdSchemaId: schema_21
                    clientIdSchemaId: schema_12
          - nodeType: container
            children:
              - nodeType: feedback
                pageSlug: /topics/driver-location/operations/publishlocationupdates
            panels: []
        showDivider: true
    - label: Consume Location Data
      type: link
      link: docs/asyncapi/topics/driver-location/operations/consumelocationupdates
      routeSlug: docs/asyncapi/topics/driver-location/operations/consumelocationupdates
      httpVerb: sub
      badges: []
      metadata:
        seo:
          title: Consume Location Data
          description: >-
            Maintains real-time driver location database for fast matching and accurate ETA calculations. Must process
            thousands of location events per second.
      content:
        contentType: item
        itemVariant: channelOperation
        meta:
          name: Consume Location Data
          pointer: /operations/consumeLocationUpdates
          protocolTag:
            label: Sub
            color: receive
          action: receive
          actionLabel: Subscribe
          channelBindings:
            kafka:
              topic: driver-location-{driverId}
              partitions: 20
              replicas: 3
              topicConfiguration:
                cleanup.policy:
                  - delete
                retention.ms: 43200000
                retention.bytes: 1073741824
                delete.retention.ms: 86400000
                max.message.bytes: 1048576
              bindingVersion: 0.4.0
        seo:
          title: Consume Location Data
          description: >-
            Maintains real-time driver location database for fast matching and accurate ETA calculations. Must process
            thousands of location events per second.
        children:
          - nodeType: container
            children:
              - nodeType: header
                level: 4
                label: Subscribe
              - nodeType: header
                level: 5
                label: Consume Location Data
                badges: []
                showPageActions: true
                protocolTag:
                  label: Sub
                  color: receive
              - nodeType: markdoc
                content: Matching service consumes the event stream of driver locations
              - nodeType: markdoc
                content: >-
                  Maintains real-time driver location database for fast matching and accurate ETA calculations. Must
                  process thousands of location events per second.
              - nodeType: message-links
                channelLink: /topics/driver-location
                messages:
                  - name: locationUpdate
                    label: Driver Location Update
            panels:
              - title: Operation configuration
                children:
                  - kind: operation-binding
                    bindingKey: kafka
                    bindingValue:
                      bindingVersion: 0.4.0
                      clientId:
                        type: string
                        description: Location processing service client identifier
                        default: location-processor
                      groupId:
                        type: string
                        description: Location data consumer group
                        default: location-consumer
                    groupIdSchemaId: schema_22
                    clientIdSchemaId: schema_23
          - nodeType: container
            children:
              - nodeType: feedback
                pageSlug: /topics/driver-location/operations/consumelocationupdates
            panels: []
        showDivider: false
- label: User Ratings Topic
  type: group
  link: docs/asyncapi/topics/ratings
  routeSlug: docs/asyncapi/topics/ratings
  httpVerb: topic
  badges: []
  metadata:
    seo:
      title: User Ratings Topic
      description: Topic for collecting and processing user experience ratings submitted by drivers and passengers.
  content:
    contentType: item
    itemVariant: channel
    meta:
      name: User Ratings Topic
      pointer: /channels/ratings
      protocolTag:
        label: Topic
        color: topic
    seo:
      title: User Ratings Topic
      description: Topic for collecting and processing user experience ratings submitted by drivers and passengers.
    children:
      - nodeType: container
        children:
          - nodeType: header
            level: 2
            label: User Ratings Topic
            showPageActions: true
            protocolTag:
              label: Topic
              color: topic
          - nodeType: channel-address
            address: ratings-{ratingDirection}
          - nodeType: markdoc
            content: Event stream of driver and passenger ratings
          - nodeType: markdoc
            content: Topic for collecting and processing user experience ratings submitted by drivers and passengers.
          - nodeType: header
            level: 4
            label: Parameters
            labelTranslationKey: parameters
            deepLinkSuffix: parameters
          - nodeType: item-content
            variant: parameters
            parameters:
              - name: ratingDirection
                in: path
                schemaId: schema_29
                description: Direction of the rating (driver->passenger or passenger->driver)
            pointer: channels/ratings/parameters
        panels:
          - children:
              - kind: brokers
                panelLabel: Brokers
                brokers:
                  - name: production
                    url: kafka.wheelyfast.io:9092
                    description: Production Kafka broker cluster
                    protocol: kafka
                    protocolVersion: 2.6.0
                    pathname: /
                    title: Production WheelyFast Kafka Brokers
                    summary: Main production messaging brokers for the WheelyFast platform
                    bindings:
                      kafka:
                        schemaRegistryUrl: https://registry.wheelyfast.io
                        schemaRegistryVendor: confluent
                    variables:
                      region:
                        description: Geographic region for the broker cluster
                        default: us-east-1
                        enum:
                          - us-east-1
                          - us-west-2
                          - eu-central-1
                      environment:
                        description: Deployment environment
                        default: production
          - title: Topic configuration
            children:
              - kind: channel-binding
                panelLabel: Topic configuration
                bindingKey: kafka
                bindingValue:
                  topic: ratings-{ratingDirection}
                  partitions: 6
                  replicas: 3
                  topicConfiguration:
                    cleanup.policy:
                      - compact
                    retention.ms: 7776000000
                    retention.bytes: 1073741824
                    delete.retention.ms: 86400000
                    max.message.bytes: 1048576
                  bindingVersion: 0.4.0
      - nodeType: container
        children:
          - nodeType: header
            level: 4
            label: Messages
            labelTranslationKey: messages
            deepLinkSuffix: messages
          - nodeType: item-content
            variant: messages
            messages:
              - name: driverRating
                label: Driver Rating
                summary: Passenger has submitted a rating for their driver
                description: >-
                  Post-ride feedback from passenger about driver performance. Contains star rating and optional feedback
                  categories.
                schemaId: components/messages/driverRating/payload
                payload:
                  $ref: '#/components/schemas/DriverRating'
                payloadLabel: Value
                externalDocs:
                  url: https://developer.wheelyfast.io/docs/ratings
                  description: Rating system documentation
              - name: passengerRating
                label: Passenger Rating
                summary: Driver has submitted a rating for their passenger
                description: Post-ride feedback from driver about passenger behavior. Contains star rating and optional comments.
                schemaId: components/messages/passengerRating/payload
                payload:
                  $ref: '#/components/schemas/PassengerRating'
                payloadLabel: Value
            pointer: channels/ratings/messages
        panels:
          - children:
              - kind: payload
                panelLabel: Value
                schemaId: components/messages/driverRating/payload
                examples: []
                messagesByKey:
                  driverRating:
                    schemaId: components/messages/driverRating/payload
                  passengerRating:
                    schemaId: components/messages/passengerRating/payload
          - title: Message configuration
            children:
              - kind: message-binding
                bindingsByMessageKey:
                  driverRating:
                    bindingKey: kafka
                    bindingValue:
                      key:
                        type: string
                        description: Ride ID
                      schemaIdLocation: value
                      schemaIdPayloadEncoding: confluent
                      bindingVersion: 0.4.0
                    keySchemaId: schema_15
                  passengerRating:
                    bindingKey: kafka
                    bindingValue:
                      key:
                        type: string
                        description: Ride ID
                      schemaIdLocation: value
                      schemaIdPayloadEncoding: confluent
                      bindingVersion: 0.4.0
                    keySchemaId: schema_15
