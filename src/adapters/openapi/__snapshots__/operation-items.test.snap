                      - name: Accept-Language
                        in: header
                        required: false
                        example: en-US
                        schemaId: schema_1
                    cookie:
                      - name: cookieParam
                        in: cookie
                        required: true
                        schemaId: schema_0
                  security:
                    - schemes:
                        - id: cafe_auth
                          type: oauth2
                          flows:
                            implicit:
                              authorizationUrl: http://cafe-api.example.com/api/oauth/dialog
                              scopes:
                                write:menu: modify menu items in your account
                                read:menu: read your menu items
                      scopes:
                        - write:menu
                        - read:menu
