          - children:
              - kind: code-sample
                source:
                  kind: code-sample
                  operationType: http
                  method: POST
                  path: /menu
                  servers:
                    - url: //cafe-api.example.com/v2
                      description: Default server
                    - url: //cafe-api.example.com/sandbox
                      description: Sandbox server
                  parameters:
                    path: []
