                    - '405'
                  pointer: /menu
                  href: menu/addmenuitem
                  openApiOperationId: addMenuItem
                  summary: Add a new coffee to the store
                definitionSamples:
                  - lang: C#
                    source: |
                      Cafe.v1.MenuItem item = new Cafe.v1.MenuItem();
                      item.setApiKey("your api key");
                      item.itemType = Cafe.v1.MenuItem.TYPE_COFFEE;
                      item.name = "Cappuccino";
                      // set other fields
                      CafeResponse response = item.create();
                      if (response.statusCode == HttpStatusCode.Created)
                      {
                        // Successfully created
                      }
                      else
                      {
                        // Something wrong -- check response for errors
                        Console.WriteLine(response.getRawResponse());
                      }
                  - lang: PHP
                    source: |
                      $form = new \Cafe\Entities\MenuItem();
                      $form->setItemType("Coffee");
                      $form->setName("Cappuccino");
                      // set other fields
                      try {
                          $item = $client->menu()->create($form);
                      } catch (UnprocessableEntityException $e) {
                          var_dump($e->getErrors());
                      }
                isWebhook: false
                hideReplay: false
                servers:
                  - url: //cafe-api.example.com/v2
                    description: Default server
                  - url: //cafe-api.example.com/sandbox
                    description: Sandbox server
                schemaId: components/schemas/MenuItem
                mediaTypes:
