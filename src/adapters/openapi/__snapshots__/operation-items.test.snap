              - name: Accept-Language
                in: header
                schemaId: schema_1
                description: The **preferred** language for messages. See [supported locales](https://example.com/locales).
                example: en-US
            pointer: /paths/~1menu/post/parameters
          - nodeType: item-content
            variant: body
