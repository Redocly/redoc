- type: group
  label: Search
  link: docs/mcp/search
  routeSlug: docs/mcp/search
  items:
    - type: link
      label: echo
      link: /docs/mcp/search/echo
      routeSlug: /docs/mcp/search/echo
      httpVerb: tool
      content:
        contentType: item
        seo:
          title: echo
        meta:
          name: echo
        children:
          - nodeType: container
            children:
              - nodeType: header
                level: 2
                label: echo
                showPageActions: true
            panels: []
          - nodeType: markdoc
            content:
              - tag: mcpTool
                attributes:
                  name: echo
                  id: docs/mcp/search/echo
    - label: Search for events
      deprecated: false
      httpVerb: get
      isAdditionalOperation: false
      isWebhook: false
      type: link
      link: /docs/mcp/search/searchevents
      routeSlug: /docs/mcp/search/searchevents
      metadata:
        seo:
          title: Search for events
          description: Search for events
      content:
        contentType: item
        itemVariant: httpItem
        meta:
          sourceId: searchEvents
          name: Search for events
          isWebhook: false
          pointer: /paths/~1events/get
          hasSamples: false
        children:
          - nodeType: container
            children:
              - nodeType: header
                level: 2
                label: Search for events
                isWebhook: false
                showPageActions: true
            panels: []
          - nodeType: container
            children:
              - nodeType: header
                level: 4
                label: Request
                labelTranslationKey: request
                deepLinkSuffix: request
              - nodeType: empty-message
                label: No request data
                labelTranslationKey: noRequestData
            panels:
              - children:
                  - kind: code-sample
                    source:
                      kind: code-sample
                      operationType: http
                      method: GET
                      path: /events
                      servers:
                        - url: http://localhost:3001/mcp
                      parameters:
                        path: []
                        query: []
                        querystring: []
                        header: []
                        cookie: []
                      security: []
                      responseCodes:
                        - '200'
                      pointer: /events
                      href: search/searchevents
                      openApiOperationId: searchEvents
                      summary: Search for events
                    isWebhook: false
                    hideReplay: false
                    servers:
                      - url: http://localhost:3001/mcp
                    examples: []
          - nodeType: container
            children:
              - nodeType: header
                level: 4
                label: Responses
                labelTranslationKey: responses
                deepLinkSuffix: responses
              - nodeType: item-content
                variant: responses
                responses:
                  - code: '200'
                    description: ok
                pointer: /paths/~1events/get/responses
            panels: []
          - nodeType: container
            children:
              - nodeType: feedback
                pageSlug: /search/searchevents
            panels: []
      httpPath: /events
  content:
    contentType: group
    meta:
      name: Search
    children:
      - nodeType: container
        children:
          - nodeType: header
            level: 2
            label: Search
            showPageActions: true
          - nodeType: markdoc
            content: Search-related operations and tools
        panels:
          - children:
              - kind: group-items
                title: Operations
                titleTranslationKey: operations
                items:
                  - title: /events
                    summary: Search for events
                    prefix:
                      name: get
                      color: get
                    badges: []
                    link: /search/searchevents
                    deprecated: false
              - kind: group-items
                title: MCP Tools
                titleTranslationKey: openapi.mcp.tools
                items:
                  - title: echo
                    prefix:
                      name: tool
                      color: tool
                    link: /search/echo
                    deprecated: false
