                graphqlTypeName: AddPullRequestReviewThreadInput
              - nodeType: item-content
                variant: graphql-fields
                label: Input Fields
                labelTranslationKey: inputFields
                schemaId: types/AddPullRequestReviewThreadInput
                graphqlTypeName: AddPullRequestReviewThreadInput
                graphqlSchema:
                  - name: body
                    type: String!
                    description: Body of the thread's first comment.
                  - name: clientMutationId
                    type: String
                    description: A unique identifier for the client performing the mutation.
                  - name: line
                    type: Int!
                    description: >-
                      The line of the blob to which the thread refers. The end of the line range for multi-line
                      comments.
                  - name: path
                    type: String!
                    description: Path to the file being commented on.
                  - name: pullRequestId
                    type: ID
                    description: The node ID of the pull request reviewing
                  - name: pullRequestReviewId
                    type: ID
                    description: The Node ID of the review to modify.
                  - name: side
                    type: DiffSide
                    description: >-
                      The side of the diff on which the line resides. For multi-line comments, this is the side for the
                      end of the line range.
                    defaultValue: RIGHT
                  - name: startLine
                    type: Int
                    description: The first line of the range to which the comment refers.
                  - name: startSide
                    type: DiffSide
                    description: The side of the diff on which the start line resides.
                    defaultValue: RIGHT
            panels:
              - children:
                  - kind: graphql-type-sample
                    schemaId: types/AddPullRequestReviewThreadInput
                    graphqlOperationData:
