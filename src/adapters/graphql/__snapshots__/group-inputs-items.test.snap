      routeSlug: docs/graphql/inputs/createsponsorshipinput
      content:
        contentType: item
        itemVariant: input
        meta:
          name: CreateSponsorshipInput
          position:
            start:
              lineNumber: 6366
              column: 1
            end:
              lineNumber: 6423
              column: 1
        seo:
          title: CreateSponsorshipInput
          description: Autogenerated input type of CreateSponsorship
        children:
          - nodeType: container
            children:
              - nodeType: header
                level: 2
                label: CreateSponsorshipInput
                showPageActions: true
              - nodeType: markdoc
                content: Autogenerated input type of CreateSponsorship
              - nodeType: item-content
                variant: requires-scopes
                graphqlTypeName: CreateSponsorshipInput
              - nodeType: item-content
                variant: graphql-fields
                label: Input Fields
                labelTranslationKey: inputFields
                schemaId: types/CreateSponsorshipInput
                graphqlTypeName: CreateSponsorshipInput
                graphqlSchema:
                  - name: amount
                    type: Int
                    description: >-
                      The amount to pay to the sponsorable in US dollars. Required if a tierId is not specified. Valid
                      values: 1-12000.
                  - name: clientMutationId
                    type: String
                    description: A unique identifier for the client performing the mutation.
                  - name: isRecurring
                    type: Boolean
                    description: >-
                      Whether the sponsorship should happen monthly/yearly or just this one time. Required if a tierId
                      is not specified.
                  - name: privacyLevel
                    type: SponsorshipPrivacy
                    description: |-
                      Specify whether others should be able to see that the sponsor is sponsoring
                      the sponsorable. Public visibility still does not reveal which tier is used.
                    defaultValue: PUBLIC
                  - name: receiveEmails
                    type: Boolean
                    description: Whether the sponsor should receive email updates from the sponsorable.
                    defaultValue: true
                  - name: sponsorId
                    type: ID
                    description: |-
                      The ID of the user or organization who is acting as the sponsor, paying for
                      the sponsorship. Required if sponsorLogin is not given.
                  - name: sponsorLogin
                    type: String
                    description: |-
                      The username of the user or organization who is acting as the sponsor, paying
                      for the sponsorship. Required if sponsorId is not given.
                  - name: sponsorableId
                    type: ID
                    description: >-
                      The ID of the user or organization who is receiving the sponsorship. Required if sponsorableLogin
                      is not given.
                  - name: sponsorableLogin
                    type: String
                    description: >-
                      The username of the user or organization who is receiving the sponsorship. Required if
                      sponsorableId is not given.
                  - name: tierId
                    type: ID
                    description: The ID of one of sponsorable's existing tiers to sponsor at. Required if amount is not specified.
            panels:
              - children:
                  - kind: graphql-type-sample
                    schemaId: types/CreateSponsorshipInput
                    graphqlOperationData:
                      operationType: query
                      operationName: CreateSponsorshipInput
                      typeName: CreateSponsorshipInput
