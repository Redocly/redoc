                    type: String
                    description:
                      - >-
                        List issues assigned to given name. Pass in  for issues with no assigned user, and  for issues
                        assigned to any user.
                  - name: createdBy
                    type: String
                    description: List issues created by given name.
                  - name: labels
                    type: '[String!]'
                    description: List issues where the list of label names exist on the issue.
                  - name: mentioned
                    type: String
                    description: List issues where the given name is mentioned in the issue.
                  - name: milestone
                    type: String
                    description:
                      - >-
                        List issues by given milestone argument. If an string representation of an integer is passed, it
                        should refer to a milestone by its number field. Pass in for issues with no milestone, and  for
                        issues that are assigned to any milestone.
                  - name: since
                    type: DateTime
                    description: List issues that have been updated at or after the given date.
                  - name: states
                    type: '[IssueState!]'
                    description: List issues filtered by the list of states given.
                  - name: viewerSubscribed
                    type: Boolean
                    description: List issues subscribed to by viewer.
                    defaultValue: false
