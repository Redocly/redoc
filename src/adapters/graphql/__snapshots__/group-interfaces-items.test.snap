                  - name: isValid
                    type: Boolean!
                    description: True if the signature is valid and verified by GitHub.
                    deprecated: false
                    args: []
                  - name: payload
                    type: String!
                    description: Payload for GPG signing object. Raw ODB object without the signature header.
                    deprecated: false
                    args: []
