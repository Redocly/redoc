              lineNumber: 38024
              column: 1
        seo:
          title: Sponsorable
          description: Entities that can be sponsored through GitHub Sponsors
        children:
          - nodeType: container
            children:
              - nodeType: header
                level: 2
                label: Sponsorable
                showPageActions: true
              - nodeType: markdoc
                content: Entities that can be sponsored through GitHub Sponsors
              - nodeType: item-content
                variant: requires-scopes
                graphqlTypeName: Sponsorable
              - nodeType: item-content
                variant: graphql-fields
                label: Fields
                labelTranslationKey: fields
                schemaId: types/Sponsorable
                graphqlTypeName: Sponsorable
                graphqlSchema:
                  - name: estimatedNextSponsorsPayoutInCents
                    type: Int!
                    description: The estimated next GitHub Sponsors payout for this user/organization in cents (USD).
                    deprecated: false
                    args: []
                  - name: hasSponsorsListing
                    type: Boolean!
                    description: True if this user/organization has a GitHub Sponsors listing.
                    deprecated: false
                    args: []
                  - name: isSponsoredBy
                    type: Boolean!
                    description: Check if the given account is sponsoring this user/organization.
                    deprecated: false
                    args:
                      - name: accountLogin
                        type: String!
                        description: The target account's login.
                  - name: isSponsoringViewer
                    type: Boolean!
                    description: True if the viewer is sponsored by this user/organization.
                    deprecated: false
                    args: []
                  - name: monthlyEstimatedSponsorsIncomeInCents
                    type: Int!
                    description: The estimated monthly GitHub Sponsors income for this user/organization in cents (USD).
                    deprecated: false
                    args: []
                  - name: sponsoring
                    type: SponsorConnection!
                    description: List of users and organizations this entity is sponsoring.
                    deprecated: false
                    args:
                      - name: after
                        type: String
                        description: Returns the elements in the list that come after the specified cursor.
                      - name: before
                        type: String
                        description: Returns the elements in the list that come before the specified cursor.
                      - name: first
                        type: Int
                        description:
                          - Returns the first n elements from the list.
                      - name: last
                        type: Int
                        description:
                          - Returns the last n elements from the list.
                      - name: orderBy
                        type: SponsorOrder
                        description: Ordering options for the users and organizations returned from the connection.
                        defaultValue:
                          direction: DESC
                          field: RELEVANCE
                  - name: sponsors
                    type: SponsorConnection!
                    description: List of sponsors for this user or organization.
                    deprecated: false
                    args:
                      - name: after
                        type: String
                        description: Returns the elements in the list that come after the specified cursor.
                      - name: before
                        type: String
                        description: Returns the elements in the list that come before the specified cursor.
                      - name: first
                        type: Int
                        description:
                          - Returns the first n elements from the list.
                      - name: last
                        type: Int
                        description:
                          - Returns the last n elements from the list.
                      - name: orderBy
                        type: SponsorOrder
                        description: Ordering options for sponsors returned from the connection.
                        defaultValue:
                          direction: DESC
                          field: RELEVANCE
                      - name: tierId
                        type: ID
                        description: |-
                          If given, will filter for sponsors at the given tier. Will only return
                          sponsors whose tier the viewer is permitted to see.
                  - name: sponsorsActivities
                    type: SponsorsActivityConnection!
                    description: Events involving this sponsorable, such as new sponsorships.
                    deprecated: false
                    args:
                      - name: after
                        type: String
                        description: Returns the elements in the list that come after the specified cursor.
                      - name: before
                        type: String
                        description: Returns the elements in the list that come before the specified cursor.
                      - name: first
                        type: Int
                        description:
                          - Returns the first n elements from the list.
                      - name: last
                        type: Int
                        description:
                          - Returns the last n elements from the list.
                      - name: orderBy
                        type: SponsorsActivityOrder
                        description: Ordering options for activity returned from the connection.
                        defaultValue:
                          direction: DESC
                          field: TIMESTAMP
                      - name: period
                        type: SponsorsActivityPeriod
                        description: Filter activities returned to only those that occurred in a given time range.
                        defaultValue: MONTH
                  - name: sponsorsListing
                    type: SponsorsListing
                    description: The GitHub Sponsors listing for this user or organization.
                    deprecated: false
                    args: []
                  - name: sponsorshipForViewerAsSponsor
                    type: Sponsorship
                    description: |-
                      The sponsorship from the viewer to this user/organization; that is, the
                      sponsorship where you're the sponsor. Only returns a sponsorship if it is active.
                    deprecated: false
                    args: []
                  - name: sponsorshipForViewerAsSponsorable
                    type: Sponsorship
                    description: |-
                      The sponsorship from this user/organization to the viewer; that is, the
                      sponsorship you're receiving. Only returns a sponsorship if it is active.
                    deprecated: false
                    args: []
                  - name: sponsorshipNewsletters
                    type: SponsorshipNewsletterConnection!
                    description: List of sponsorship updates sent from this sponsorable to sponsors.
                    deprecated: false
                    args:
                      - name: after
                        type: String
                        description: Returns the elements in the list that come after the specified cursor.
                      - name: before
                        type: String
                        description: Returns the elements in the list that come before the specified cursor.
                      - name: first
                        type: Int
                        description:
                          - Returns the first n elements from the list.
                      - name: last
                        type: Int
                        description:
                          - Returns the last n elements from the list.
                      - name: orderBy
                        type: SponsorshipNewsletterOrder
                        description: Ordering options for sponsorship updates returned from the connection.
                        defaultValue:
                          direction: DESC
                          field: CREATED_AT
                  - name: sponsorshipsAsMaintainer
                    type: SponsorshipConnection!
                    description: This object's sponsorships as the maintainer.
                    deprecated: false
                    args:
                      - name: after
                        type: String
                        description: Returns the elements in the list that come after the specified cursor.
                      - name: before
                        type: String
                        description: Returns the elements in the list that come before the specified cursor.
                      - name: first
                        type: Int
                        description:
                          - Returns the first n elements from the list.
                      - name: includePrivate
                        type: Boolean
                        description: Whether or not to include private sponsorships in the result set
                        defaultValue: false
                      - name: last
                        type: Int
                        description:
                          - Returns the last n elements from the list.
                      - name: orderBy
                        type: SponsorshipOrder
                        description: |-
                          Ordering options for sponsorships returned from this connection. If left
                          blank, the sponsorships will be ordered based on relevancy to the viewer.
                  - name: sponsorshipsAsSponsor
                    type: SponsorshipConnection!
                    description: This object's sponsorships as the sponsor.
                    deprecated: false
                    args:
                      - name: after
                        type: String
                        description: Returns the elements in the list that come after the specified cursor.
                      - name: before
                        type: String
                        description: Returns the elements in the list that come before the specified cursor.
                      - name: first
                        type: Int
                        description:
                          - Returns the first n elements from the list.
                      - name: last
                        type: Int
                        description:
                          - Returns the last n elements from the list.
                      - name: orderBy
                        type: SponsorshipOrder
                        description: |-
                          Ordering options for sponsorships returned from this connection. If left
                          blank, the sponsorships will be ordered based on relevancy to the viewer.
                  - name: viewerCanSponsor
                    type: Boolean!
                    description: Whether or not the viewer is able to sponsor this user/organization.
                    deprecated: false
                    args: []
                  - name: viewerIsSponsoring
                    type: Boolean!
                    description: True if the viewer is sponsoring this user/organization.
                    deprecated: false
                    args: []
              - nodeType: item-content
                variant: implemented-by
                label: Implemented by
                labelTranslationKey: implementedBy
                graphqlTypeNames:
                  - Organization
                  - User
            panels:
              - children:
                  - kind: graphql-type-sample
