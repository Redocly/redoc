              lineNumber: 11
              column: 1
            end:
              lineNumber: 24
              column: 6
        seo:
          title: '@possibleTypes'
          description: Defines what type of global IDs are accepted for a mutation argument of type ID.
        children:
          - nodeType: container
            children:
              - nodeType: header
                level: 2
                label: '@possibleTypes'
                showPageActions: true
              - nodeType: markdoc
                content: Defines what type of global IDs are accepted for a mutation argument of type ID.
              - nodeType: item-content
                variant: graphql-args
                label: Arguments
                labelTranslationKey: arguments.label
                graphqlTypeName: possibleTypes
                graphqlSchema:
                  - name: abstractType
                    type: String
                    description: Abstract type of accepted global ID
                  - name: concreteTypes
                    type: '[String!]!'
                    description: Accepted types of global IDs.
            panels:
              - title: Locations
                titleTranslationKey: locations
                children:
                  - kind: locations
                    locations:
                      - INPUT_FIELD_DEFINITION
          - nodeType: container
