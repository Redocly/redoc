            start:
              lineNumber: 1
              column: 1
            end:
              lineNumber: 9
              column: 120
        seo:
          title: '@preview'
          description: Marks an element of a GraphQL schema as only available via a preview header
        children:
          - nodeType: container
            children:
              - nodeType: header
                level: 2
                label: '@preview'
                showPageActions: true
              - nodeType: markdoc
                content: Marks an element of a GraphQL schema as only available via a preview header
              - nodeType: item-content
                variant: graphql-args
                label: Arguments
                labelTranslationKey: arguments.label
                graphqlTypeName: preview
                graphqlSchema:
                  - name: toggledBy
                    type: String!
                    description: The identifier of the API preview that toggles this field.
            panels:
              - title: Locations
                titleTranslationKey: locations
                children:
                  - kind: locations
                    locations:
                      - SCALAR
                      - OBJECT
                      - FIELD_DEFINITION
                      - ARGUMENT_DEFINITION
                      - INTERFACE
                      - UNION
                      - ENUM
                      - ENUM_VALUE
                      - INPUT_OBJECT
                      - INPUT_FIELD_DEFINITION
          - nodeType: container
            children:
              - nodeType: feedback
                pageSlug: /directives/preview
            panels: []
    - type: link
      label: '@possibleTypes'
