          lineNumber: 21580
          column: 1
    seo:
      title: OrgRemoveMemberAuditEntryMembershipType
      description: The type of membership a user has with an Organization.
    children:
      - nodeType: container
        children:
          - nodeType: header
            level: 2
            label: OrgRemoveMemberAuditEntryMembershipType
            showPageActions: true
          - nodeType: markdoc
            content: The type of membership a user has with an Organization.
          - nodeType: item-content
            variant: requires-scopes
            graphqlTypeName: OrgRemoveMemberAuditEntryMembershipType
          - nodeType: item-content
            variant: values
            label: Values
            labelTranslationKey: values
            schemaId: types/OrgRemoveMemberAuditEntryMembershipType
            values:
              - name: ADMIN
                description: |-
                  Organization administrators have full access and can change several settings,
                  including the names of repositories that belong to the Organization and Owners
                  team membership. In addition, organization admins can delete the organization
                  and all of its repositories.
                deprecated: false
              - name: BILLING_MANAGER
                description: >-
                  A billing manager is a user who manages the billing settings for the Organization, such as updating
                  payment information.
                deprecated: false
              - name: DIRECT_MEMBER
                description: A direct member is a user that is a member of the Organization.
                deprecated: false
              - name: OUTSIDE_COLLABORATOR
                description: |-
                  An outside collaborator is a person who isn't explicitly a member of the
                  Organization, but who has Read, Write, or Admin permissions to one or more
                  repositories in the organization.
                deprecated: false
              - name: UNAFFILIATED
                description: |-
                  An unaffiliated collaborator is a person who is not a member of the
                  Organization and does not have access to any repositories in the Organization.
                deprecated: false
        panels:
          - title: Referenced in
            titleTranslationKey: referenced
            children:
              - kind: references
                graphqlTypeName: OrgRemoveMemberAuditEntryMembershipType
                references: []
      - nodeType: container
        children:
          - nodeType: feedback
            pageSlug: /enums/orgremovememberauditentrymembershiptype
