- type: link
  label: updateRefs
  link: docs/graphql/mutations/updaterefs
  routeSlug: docs/graphql/mutations/updaterefs
  content:
    contentType: item
    itemVariant: mutation
    meta:
      name: updateRefs
      returnType: UpdateRefsPayload
      deprecated: false
      position:
        start:
          lineNumber: 19238
          column: 3
        end:
          lineNumber: 19263
          column: 65
    seo:
      title: updateRefs
      description: |-
        Creates, updates and/or deletes multiple refs in a repository.

        This mutation takes a list of `RefUpdate`s and performs these updates
        on the repository. All updates are performed atomically, meaning that
        if one of them is rejected, no other ref will be modified.

        `RefUpdate.beforeOid` specifies that the given reference needs to point
        to the given value before performing any updates. A value of
        `0000000000000000000000000000000000000000` can be used to verify that
        the references should not exist.

        `RefUpdate.afterOid` specifies the value that the given reference
        will point to after performing all updates. A value of
        `0000000000000000000000000000000000000000` can be used to delete a
        reference.

        If `RefUpdate.force` is set to `true`, a non-fast-forward updates
        for the given reference will be allowed.
    children:
      - nodeType: container
        children:
          - nodeType: header
            level: 2
            label: updateRefs
            showPageActions: true
            graphqlReturnType: UpdateRefsPayload
            graphqlArgs:
              - name: input
            graphqlDeprecated: false
            graphqlOperationType: mutation
          - nodeType: markdoc
            content:
              - Creates, updates and/or deletes multiple refs in a repository.
              - >-
                This mutation takes a list of s and performs these updates on the repository. All updates are performed
                atomically, meaning that if one of them is rejected, no other ref will be modified.
              - ' specifies that the given reference needs to point to the given value before performing any updates. A value of can be used to verify that the references should not exist.'
              - ' specifies the value that the given reference will point to after performing all updates. A value of can be used to delete a reference.'
              - If  is set to , a non-fast-forward updates for the given reference will be allowed.
          - nodeType: item-content
            variant: requires-scopes
            graphqlTypeName: updateRefs
            graphqlFieldName: updateRefs
            graphqlOperationType: mutation
          - nodeType: item-content
            variant: graphql-args
            label: Arguments
            labelTranslationKey: arguments.label
            graphqlTypeName: updateRefs
            graphqlFieldName: updateRefs
            graphqlOperationType: mutation
            graphqlSchema:
              - name: input
                type: UpdateRefsInput!
                description: Parameters for UpdateRefs
          - nodeType: item-content
            variant: return-type
            label: Return type
            labelTranslationKey: returnTypes.label
            schemaId: types/UpdateRefsPayload
            graphqlTypeName: UpdateRefsPayload
            graphqlOperationType: mutation
            graphqlFieldName: updateRefs
            graphqlSchema:
              type: UpdateRefsPayload
              description: Autogenerated return type of UpdateRefs
              fields:
                - name: clientMutationId
                  type: String
                  description: A unique identifier for the client performing the mutation.
        panels:
          - children:
              - kind: graphql-query
                graphqlOperationData:
                  operationType: mutation
