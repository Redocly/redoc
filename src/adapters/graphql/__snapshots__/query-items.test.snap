            graphqlOperationType: query
            graphqlSchema:
              - name: key
                type: String!
                description: The license's downcased SPDX ID
          - nodeType: item-content
            variant: return-type
            label: Return type
            labelTranslationKey: returnTypes.label
            schemaId: types/License
            graphqlTypeName: License
            graphqlOperationType: query
            graphqlFieldName: license
            graphqlSchema:
              type: License
              description: A repository's open source license
              fields:
                - name: body
                  type: String!
                  description: The full text of the license
                - name: conditions
                  type: '[LicenseRule]!'
                  description: The conditions set by the license
                - name: description
                  type: String
                  description: A human-readable description of the license
                - name: featured
                  type: Boolean!
                  description: Whether the license should be featured
                - name: hidden
                  type: Boolean!
                  description: Whether the license should be displayed in license pickers
                - name: id
                  type: ID!
                  description: []
                - name: implementation
                  type: String
                  description: Instructions on how to implement the license
                - name: key
                  type: String!
                  description: The lowercased SPDX ID of the license
                - name: limitations
                  type: '[LicenseRule]!'
                  description: The limitations set by the license
                - name: name
                  type: String!
                  description:
                    - The license full name specified by https://spdx.org/licenses
                - name: nickname
                  type: String
                  description: Customary short name if applicable (e.g, GPLv3)
                - name: permissions
                  type: '[LicenseRule]!'
                  description: The permissions set by the license
                - name: pseudoLicense
                  type: Boolean!
                  description: Whether the license is a pseudo-license placeholder (e.g., other, no-license)
                - name: spdxId
                  type: String
                  description:
                    - Short identifier specified by https://spdx.org/licenses
                - name: url
                  type: URI
                  description:
                    - URL to the license on https://choosealicense.com
        panels:
          - children:
