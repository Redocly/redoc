                  - >-
                    Optional filter for which dependencies should be checked for sponsorable owners. Only sponsorable
                    owners of dependencies in this ecosystem will be included. Used when onlyDependencies = true.
              - name: first
                type: Int
                description:
                  - Returns the first n elements from the list.
              - name: last
                type: Int
                description:
                  - Returns the last n elements from the list.
              - name: onlyDependencies
                type: Boolean
                description: |-
                  Whether only sponsorables who own the viewer's dependencies will be
                  returned. Must be authenticated to use. Can check an organization instead
                  for their dependencies owned by sponsorables by passing
                  orgLoginForDependencies.
                defaultValue: false
              - name: orderBy
                type: SponsorableOrder
                description: Ordering options for users and organizations returned from the connection.
                defaultValue:
                  direction: ASC
                  field: LOGIN
              - name: orgLoginForDependencies
                type: String
                description:
                  - >-
                    Optional organization username for whose dependencies should be checked. Used when onlyDependencies
                    = true. Omit to check your own dependencies. If you are not an administrator of the organization,
                    only dependencies from its public repositories will be considered.
          - nodeType: item-content
            variant: return-type
            label: Return type
            labelTranslationKey: returnTypes.label
            schemaId: types/SponsorableItemConnection
            graphqlTypeName: SponsorableItemConnection
            graphqlOperationType: query
            graphqlFieldName: sponsorables
            graphqlSchema:
              type: SponsorableItemConnection!
              description: The connection type for SponsorableItem.
              fields:
                - name: edges
                  type: '[SponsorableItemEdge]'
                  description: A list of edges.
                - name: nodes
                  type: '[SponsorableItem]'
                  description: A list of nodes.
                - name: pageInfo
                  type: PageInfo!
                  description: Information to aid in pagination.
                - name: totalCount
                  type: Int!
                  description: Identifies the total count of items in the connection.
        panels:
          - children:
              - kind: graphql-query
                graphqlOperationData:
                  operationType: query
                  operationName: sponsorables
                  typeName: SponsorableItemConnection
                schemaId: types/SponsorableItemConnection
                examples: []
          - children:
              - kind: graphql-response
                graphqlOperationData:
                  operationType: query
                  operationName: sponsorables
                  typeName: SponsorableItemConnection
                schemaId: types/SponsorableItemConnection
                examples: []
      - nodeType: container
        children:
          - nodeType: feedback
            pageSlug: /queries/sponsorables
        panels: []
