                  - name: orderBy
                    type: OrganizationOrder
                    description: Ordering options for organizations with this setting.
                    defaultValue:
                      direction: ASC
                      field: LOGIN
                  - name: value
                    type: Boolean!
                    description: The setting value to find organizations for.
