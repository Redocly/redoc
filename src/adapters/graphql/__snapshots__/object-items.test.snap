                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
                  - name: orderBy
                    type: OrganizationOrder
                    description: Ordering options for organizations returned from the connection.
                    defaultValue:
                      direction: ASC
                      field: LOGIN
                  - name: query
