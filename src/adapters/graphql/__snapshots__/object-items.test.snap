  label: PullRequestReviewThread
  link: docs/graphql/objects/pullrequestreviewthread
  routeSlug: docs/graphql/objects/pullrequestreviewthread
  content:
    contentType: item
    itemVariant: object
    meta:
      name: PullRequestReviewThread
      position:
        start:
          lineNumber: 28168
          column: 1
        end:
          lineNumber: 28282
          column: 1
    seo:
      title: PullRequestReviewThread
      description: A threaded list of comments for a given pull request.
    children:
      - nodeType: container
        children:
          - nodeType: header
            level: 2
            label: PullRequestReviewThread
            showPageActions: true
          - nodeType: markdoc
            content: A threaded list of comments for a given pull request.
          - nodeType: item-content
            variant: requires-scopes
            graphqlTypeName: PullRequestReviewThread
          - nodeType: item-content
            variant: graphql-fields
            label: Fields
            labelTranslationKey: fields
            schemaId: types/PullRequestReviewThread
            graphqlTypeName: PullRequestReviewThread
            graphqlSchema:
              - name: comments
                type: PullRequestReviewCommentConnection!
                description: A list of pull request comments associated with the thread.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
                  - name: skip
                    type: Int
                    description:
                      - Skips the first n elements in the list.
              - name: diffSide
                type: DiffSide!
                description: The side of the diff on which this thread was placed.
                deprecated: false
                args: []
              - name: id
                type: ID!
                description: []
                deprecated: false
                args: []
              - name: isCollapsed
                type: Boolean!
                description: Whether or not the thread has been collapsed (resolved)
                deprecated: false
                args: []
              - name: isOutdated
                type: Boolean!
                description: Indicates whether this thread was outdated by newer changes.
                deprecated: false
                args: []
              - name: isResolved
                type: Boolean!
                description: Whether this thread has been resolved
                deprecated: false
                args: []
              - name: line
                type: Int
                description: The line in the file to which this thread refers
                deprecated: false
                args: []
              - name: originalLine
                type: Int
                description: The original line in the file to which this thread refers.
                deprecated: false
                args: []
              - name: originalStartLine
                type: Int
                description: The original start line in the file to which this thread refers (multi-line only).
                deprecated: false
                args: []
              - name: path
                type: String!
                description: Identifies the file path of this thread.
                deprecated: false
                args: []
              - name: pullRequest
                type: PullRequest!
                description: Identifies the pull request associated with this thread.
                deprecated: false
                args: []
              - name: repository
                type: Repository!
                description: Identifies the repository associated with this thread.
                deprecated: false
                args: []
              - name: resolvedBy
                type: User
                description: The user who resolved this thread
                deprecated: false
                args: []
              - name: startDiffSide
                type: DiffSide
                description: The side of the diff that the first line of the thread starts on (multi-line only)
                deprecated: false
                args: []
              - name: startLine
                type: Int
                description: The start line in the file to which this thread refers (multi-line only)
                deprecated: false
                args: []
              - name: viewerCanReply
                type: Boolean!
                description: Indicates whether the current viewer can reply to this thread.
                deprecated: false
                args: []
              - name: viewerCanResolve
                type: Boolean!
                description: Whether or not the viewer can resolve this thread
                deprecated: false
                args: []
              - name: viewerCanUnresolve
                type: Boolean!
                description: Whether or not the viewer can unresolve this thread
                deprecated: false
                args: []
