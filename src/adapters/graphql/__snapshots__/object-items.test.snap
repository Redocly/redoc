  label: Commit
  link: docs/graphql/objects/commit
  routeSlug: docs/graphql/objects/commit
  content:
    contentType: item
    itemVariant: object
    meta:
      name: Commit
      position:
        start:
          lineNumber: 3621
          column: 1
        end:
          lineNumber: 4055
          column: 1
    seo:
      title: Commit
      description: Represents a Git commit.
    children:
      - nodeType: container
        children:
          - nodeType: header
            level: 2
            label: Commit
            showPageActions: true
          - nodeType: markdoc
            content: Represents a Git commit.
          - nodeType: item-content
            variant: requires-scopes
            graphqlTypeName: Commit
          - nodeType: item-content
            variant: graphql-fields
            label: Fields
            labelTranslationKey: fields
            schemaId: types/Commit
            graphqlTypeName: Commit
            graphqlSchema:
              - name: abbreviatedOid
                type: String!
                description: An abbreviated version of the Git object ID
                deprecated: false
                args: []
              - name: additions
                type: Int!
                description: The number of additions in this commit.
                deprecated: false
                args: []
              - name: associatedPullRequests
                type: PullRequestConnection
                description: |-
                  The merged Pull Request that introduced the commit to the repository. If the
                  commit is not present in the default branch, additionally returns open Pull
                  Requests associated with the commit
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
                  - name: orderBy
                    type: PullRequestOrder
                    description: Ordering options for pull requests.
                    defaultValue:
                      direction: ASC
                      field: CREATED_AT
              - name: author
                type: GitActor
                description: Authorship details of the commit.
                deprecated: false
                args: []
              - name: authoredByCommitter
                type: Boolean!
                description: Check if the committer and the author match.
                deprecated: false
                args: []
              - name: authoredDate
                type: DateTime!
                description: The datetime when this commit was authored.
                deprecated: false
                args: []
              - name: authors
                type: GitActorConnection!
                description: |-
                  The list of authors for this commit based on the git author and the Co-authored-by
                  message trailer. The git author will always be first.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
              - name: blame
                type: Blame!
                description:
                  - Fetches  information.
                deprecated: false
                args:
                  - name: path
                    type: String!
                    description: The file whose Git blame information you want.
              - name: changedFiles
                type: Int!
                description: The number of changed files in this commit.
                deprecated: false
                args: []
              - name: checkSuites
                type: CheckSuiteConnection
                description: The check suites associated with a commit.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: filterBy
                    type: CheckSuiteFilter
                    description: Filters the check suites by this type.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
              - name: comments
                type: CommitCommentConnection!
                description: Comments made on the commit.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
              - name: commitResourcePath
                type: URI!
                description: The HTTP path for this Git object
                deprecated: false
                args: []
              - name: commitUrl
                type: URI!
                description: The HTTP URL for this Git object
                deprecated: false
                args: []
              - name: committedDate
                type: DateTime!
                description: The datetime when this commit was committed.
                deprecated: false
                args: []
              - name: committedViaWeb
                type: Boolean!
                description: Check if committed via GitHub web UI.
                deprecated: false
                args: []
              - name: committer
                type: GitActor
                description: Committer details of the commit.
                deprecated: false
                args: []
              - name: deletions
                type: Int!
                description: The number of deletions in this commit.
                deprecated: false
                args: []
              - name: deployments
                type: DeploymentConnection
                description: The deployments associated with a commit.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: environments
                    type: '[String!]'
                    description: Environments to list deployments for
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
                  - name: orderBy
                    type: DeploymentOrder
                    description: Ordering options for deployments returned from the connection.
                    defaultValue:
                      direction: ASC
                      field: CREATED_AT
              - name: file
                type: TreeEntry
                description: The tree entry representing the file located at the given path.
                deprecated: false
                args:
                  - name: path
                    type: String!
                    description: The path for the file
              - name: history
                type: CommitHistoryConnection!
                description:
                  - The linear commit history starting from (and including) this commit, in the same order as .
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: author
                    type: CommitAuthor
                    description: If non-null, filters history to only show commits with matching authorship.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
                  - name: path
                    type: String
                    description: If non-null, filters history to only show commits touching files under this path.
                  - name: since
                    type: GitTimestamp
                    description: Allows specifying a beginning time or date for fetching commits.
                  - name: until
                    type: GitTimestamp
                    description: Allows specifying an ending time or date for fetching commits.
              - name: id
                type: ID!
                description: []
                deprecated: false
                args: []
              - name: message
                type: String!
                description: The Git commit message
                deprecated: false
                args: []
              - name: messageBody
                type: String!
                description: The Git commit message body
                deprecated: false
                args: []
              - name: messageBodyHTML
                type: HTML!
                description: The commit message body rendered to HTML.
                deprecated: false
                args: []
              - name: messageHeadline
                type: String!
                description: The Git commit message headline
                deprecated: false
                args: []
              - name: messageHeadlineHTML
                type: HTML!
                description: The commit message headline rendered to HTML.
                deprecated: false
                args: []
              - name: oid
                type: GitObjectID!
                description: The Git object ID
                deprecated: false
                args: []
              - name: onBehalfOf
                type: Organization
                description: The organization this commit was made on behalf of.
                deprecated: false
                args: []
              - name: parents
                type: CommitConnection!
                description: The parents of a commit.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
              - name: pushedDate
                type: DateTime
                description: The datetime when this commit was pushed.
                deprecated: false
                args: []
              - name: repository
                type: Repository!
                description: The Repository this commit belongs to
                deprecated: false
                args: []
              - name: resourcePath
                type: URI!
                description: The HTTP path for this commit
                deprecated: false
                args: []
              - name: signature
                type: GitSignature
                description: Commit signing information, if present.
                deprecated: false
                args: []
              - name: status
                type: Status
                description: Status information for this commit
                deprecated: false
                args: []
              - name: statusCheckRollup
                type: StatusCheckRollup
                description: Check and Status rollup information for this commit.
                deprecated: false
                args: []
              - name: submodules
                type: SubmoduleConnection!
                description: >-
                  Returns a list of all submodules in this repository as of this Commit parsed from the .gitmodules
                  file.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
              - name: tarballUrl
                type: URI!
                description: |-
                  Returns a URL to download a tarball archive for a repository.
                  Note: For private repositories, these links are temporary and expire after five minutes.
                deprecated: false
                args: []
              - name: tree
                type: Tree!
                description: Commit's root Tree
                deprecated: false
                args: []
              - name: treeResourcePath
                type: URI!
                description: The HTTP path for the tree of this commit
                deprecated: false
                args: []
              - name: treeUrl
                type: URI!
                description: The HTTP URL for the tree of this commit
                deprecated: false
                args: []
              - name: url
                type: URI!
                description: The HTTP URL for this commit
                deprecated: false
                args: []
              - name: viewerCanSubscribe
                type: Boolean!
                description: Check if the viewer is able to change their subscription status for the repository.
                deprecated: false
                args: []
              - name: viewerSubscription
                type: SubscriptionState
                description: Identifies if the viewer is watching, not watching, or ignoring the subscribable entity.
                deprecated: false
                args: []
              - name: zipballUrl
                type: URI!
                description: |-
                  Returns a URL to download a zipball archive for a repository.
                  Note: For private repositories, these links are temporary and expire after five minutes.
                deprecated: false
                args: []
          - nodeType: item-content
            variant: implements
            label: Implements interfaces
            labelTranslationKey: implementedInterfaces
            graphqlInterfaceNames:
              - GitObject
              - Node
              - Subscribable
              - UniformResourceLocatable
        panels:
          - children:
              - kind: graphql-type-sample
