    seo:
      title: SecurityVulnerability
      description: An individual vulnerability within an Advisory
    children:
      - nodeType: container
        children:
          - nodeType: header
            level: 2
            label: SecurityVulnerability
            showPageActions: true
          - nodeType: markdoc
            content: An individual vulnerability within an Advisory
          - nodeType: item-content
            variant: requires-scopes
            graphqlTypeName: SecurityVulnerability
          - nodeType: item-content
            variant: graphql-fields
            label: Fields
            labelTranslationKey: fields
            schemaId: types/SecurityVulnerability
            graphqlTypeName: SecurityVulnerability
            graphqlSchema:
              - name: advisory
                type: SecurityAdvisory!
                description: The Advisory associated with this Vulnerability
                deprecated: false
                args: []
              - name: firstPatchedVersion
                type: SecurityAdvisoryPackageVersion
                description: The first version containing a fix for the vulnerability
                deprecated: false
                args: []
              - name: package
                type: SecurityAdvisoryPackage!
                description: A description of the vulnerable package
                deprecated: false
                args: []
              - name: severity
                type: SecurityAdvisorySeverity!
                description: The severity of the vulnerability within this package
                deprecated: false
                args: []
              - name: updatedAt
                type: DateTime!
                description: When the vulnerability was last updated
                deprecated: false
                args: []
              - name: vulnerableVersionRange
                type: String!
                description:
                  - >-
                    A string that describes the vulnerable package versions. This string follows a basic syntax with a
                    few forms.
                  - ' denotes a single vulnerable version. denotes a version range up to and including the specified version denotes a version range up to, but excluding, the specified version denotes a version range with a known minimum and maximum version. denotes a version range with a known minimum, but no known maximum'
                deprecated: false
                args: []
        panels:
          - children:
              - kind: graphql-type-sample
                schemaId: types/SecurityVulnerability
                graphqlOperationData:
                  operationType: query
                  operationName: SecurityVulnerability
                  typeName: SecurityVulnerability
