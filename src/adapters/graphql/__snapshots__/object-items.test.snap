                type: Boolean!
                description: Will new commits pushed to matching branches dismiss pull request review approvals.
                deprecated: false
                args: []
              - name: id
                type: ID!
                description: []
                deprecated: false
                args: []
              - name: isAdminEnforced
                type: Boolean!
                description: Can admins overwrite branch protection.
