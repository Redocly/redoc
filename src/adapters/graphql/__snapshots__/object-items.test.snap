  label: PullRequest
  link: docs/graphql/objects/pullrequest
  routeSlug: docs/graphql/objects/pullrequest
  content:
    contentType: item
    itemVariant: object
    meta:
      name: PullRequest
      position:
        start:
          lineNumber: 26257
          column: 1
        end:
          lineNumber: 27137
          column: 1
    seo:
      title: PullRequest
      description: A repository pull request.
    children:
      - nodeType: container
        children:
          - nodeType: header
            level: 2
            label: PullRequest
            showPageActions: true
          - nodeType: markdoc
            content: A repository pull request.
          - nodeType: item-content
            variant: requires-scopes
            graphqlTypeName: PullRequest
          - nodeType: item-content
            variant: graphql-fields
            label: Fields
            labelTranslationKey: fields
            schemaId: types/PullRequest
            graphqlTypeName: PullRequest
            graphqlSchema:
              - name: activeLockReason
                type: LockReason
                description: Reason that the conversation was locked.
                deprecated: false
                args: []
              - name: additions
                type: Int!
                description: The number of additions in this pull request.
                deprecated: false
                args: []
              - name: assignees
                type: UserConnection!
                description: A list of Users assigned to this object.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
              - name: author
                type: Actor
                description: The actor who authored the comment.
                deprecated: false
                args: []
              - name: authorAssociation
                type: CommentAuthorAssociation!
                description: Author's association with the subject of the comment.
                deprecated: false
                args: []
              - name: autoMergeRequest
                type: AutoMergeRequest
                description: Returns the auto-merge request object if one exists for this pull request.
                deprecated: false
                args: []
              - name: baseRef
                type: Ref
                description: Identifies the base Ref associated with the pull request.
                deprecated: false
                args: []
              - name: baseRefName
                type: String!
                description: >-
                  Identifies the name of the base Ref associated with the pull request, even if the ref has been
                  deleted.
                deprecated: false
                args: []
              - name: baseRefOid
                type: GitObjectID!
                description: Identifies the oid of the base ref associated with the pull request, even if the ref has been deleted.
                deprecated: false
                args: []
              - name: baseRepository
                type: Repository
                description: The repository associated with this pull request's base Ref.
                deprecated: false
                args: []
              - name: body
                type: String!
                description: The body as Markdown.
                deprecated: false
                args: []
              - name: bodyHTML
                type: HTML!
                description: The body rendered to HTML.
                deprecated: false
                args: []
              - name: bodyText
                type: String!
                description: The body rendered to text.
                deprecated: false
                args: []
              - name: canBeRebased
                type: Boolean!
                description: Whether or not the pull request is rebaseable.
                deprecated: false
                args: []
              - name: changedFiles
                type: Int!
                description: The number of changed files in this pull request.
                deprecated: false
                args: []
              - name: checksResourcePath
                type: URI!
                description: The HTTP path for the checks of this pull request.
                deprecated: false
                args: []
              - name: checksUrl
                type: URI!
                description: The HTTP URL for the checks of this pull request.
                deprecated: false
                args: []
              - name: closed
                type: Boolean!
                description:
                  - ' if the pull request is closed'
                deprecated: false
                args: []
              - name: closedAt
                type: DateTime
                description: Identifies the date and time when the object was closed.
                deprecated: false
                args: []
              - name: closingIssuesReferences
                type: IssueConnection
                description: List of issues that were may be closed by this pull request
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
                  - name: orderBy
                    type: IssueOrder
                    description: Ordering options for issues returned from the connection
              - name: comments
                type: IssueCommentConnection!
                description: A list of comments associated with the pull request.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
                  - name: orderBy
                    type: IssueCommentOrder
                    description: Ordering options for issue comments returned from the connection.
              - name: commits
                type: PullRequestCommitConnection!
                description: A list of commits present in this pull request's head branch not present in the base branch.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
              - name: createdAt
                type: DateTime!
                description: Identifies the date and time when the object was created.
                deprecated: false
                args: []
              - name: createdViaEmail
                type: Boolean!
                description: Check if this comment was created via an email reply.
                deprecated: false
                args: []
              - name: databaseId
                type: Int
                description: Identifies the primary key from the database.
                deprecated: false
                args: []
              - name: deletions
                type: Int!
                description: The number of deletions in this pull request.
                deprecated: false
                args: []
              - name: editor
                type: Actor
                description: The actor who edited this pull request's body.
                deprecated: false
                args: []
              - name: files
                type: PullRequestChangedFileConnection
                description: Lists the files changed within this pull request.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
              - name: headRef
                type: Ref
                description: Identifies the head Ref associated with the pull request.
                deprecated: false
                args: []
              - name: headRefName
                type: String!
                description: >-
                  Identifies the name of the head Ref associated with the pull request, even if the ref has been
                  deleted.
                deprecated: false
                args: []
              - name: headRefOid
                type: GitObjectID!
                description: Identifies the oid of the head ref associated with the pull request, even if the ref has been deleted.
                deprecated: false
                args: []
              - name: headRepository
                type: Repository
                description: The repository associated with this pull request's head Ref.
                deprecated: false
                args: []
              - name: headRepositoryOwner
                type: RepositoryOwner
                description: The owner of the repository associated with this pull request's head Ref.
                deprecated: false
                args: []
              - name: hovercard
                type: Hovercard!
                description: The hovercard information for this issue
                deprecated: false
                args:
                  - name: includeNotificationContexts
                    type: Boolean
                    description: Whether or not to include notification contexts
                    defaultValue: true
              - name: id
                type: ID!
                description: []
                deprecated: false
                args: []
              - name: includesCreatedEdit
                type: Boolean!
                description: Check if this comment was edited and includes an edit with the creation data
                deprecated: false
                args: []
              - name: isCrossRepository
                type: Boolean!
                description: The head and base repositories are different.
                deprecated: false
                args: []
              - name: isDraft
                type: Boolean!
                description: Identifies if the pull request is a draft.
                deprecated: false
                args: []
              - name: isReadByViewer
                type: Boolean
                description: Is this pull request read by the viewer
                deprecated: false
                args: []
              - name: labels
                type: LabelConnection
                description: A list of labels associated with the object.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
                  - name: orderBy
                    type: LabelOrder
                    description: Ordering options for labels returned from the connection.
                    defaultValue:
                      direction: ASC
                      field: CREATED_AT
              - name: lastEditedAt
                type: DateTime
                description: The moment the editor made the last edit
                deprecated: false
                args: []
              - name: latestOpinionatedReviews
                type: PullRequestReviewConnection
                description: A list of latest reviews per user associated with the pull request.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
                  - name: writersOnly
                    type: Boolean
                    description: Only return reviews from user who have write access to the repository
                    defaultValue: false
              - name: latestReviews
                type: PullRequestReviewConnection
                description: A list of latest reviews per user associated with the pull request that are not also pending review.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
              - name: locked
                type: Boolean!
                description:
                  - ' if the pull request is locked'
                deprecated: false
                args: []
