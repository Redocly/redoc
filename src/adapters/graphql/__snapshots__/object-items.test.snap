  label: SecurityAdvisory
  link: docs/graphql/objects/securityadvisory
  routeSlug: docs/graphql/objects/securityadvisory
  content:
    contentType: item
    itemVariant: object
    meta:
      name: SecurityAdvisory
      position:
        start:
          lineNumber: 37003
          column: 1
        end:
          lineNumber: 37147
          column: 1
    seo:
      title: SecurityAdvisory
      description: A GitHub Security Advisory
    children:
      - nodeType: container
        children:
          - nodeType: header
            level: 2
            label: SecurityAdvisory
            showPageActions: true
          - nodeType: markdoc
            content: A GitHub Security Advisory
          - nodeType: item-content
            variant: requires-scopes
            graphqlTypeName: SecurityAdvisory
          - nodeType: item-content
            variant: graphql-fields
            label: Fields
            labelTranslationKey: fields
            schemaId: types/SecurityAdvisory
            graphqlTypeName: SecurityAdvisory
            graphqlSchema:
              - name: cvss
                type: CVSS!
                description: The CVSS associated with this advisory
                deprecated: false
                args: []
              - name: cwes
                type: CWEConnection!
                description: CWEs associated with this Advisory
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
              - name: databaseId
                type: Int
                description: Identifies the primary key from the database.
                deprecated: false
                args: []
              - name: description
                type: String!
                description: This is a long plaintext description of the advisory
                deprecated: false
                args: []
              - name: ghsaId
                type: String!
                description: The GitHub Security Advisory ID
                deprecated: false
                args: []
              - name: id
                type: ID!
                description: []
                deprecated: false
                args: []
              - name: identifiers
                type: '[SecurityAdvisoryIdentifier!]!'
                description: A list of identifiers for this advisory
                deprecated: false
                args: []
              - name: notificationsPermalink
                type: URI
                description: The permalink for the advisory's dependabot alerts page
                deprecated: false
                args: []
              - name: origin
                type: String!
                description: The organization that originated the advisory
                deprecated: false
                args: []
              - name: permalink
                type: URI
                description: The permalink for the advisory
                deprecated: false
                args: []
              - name: publishedAt
                type: DateTime!
                description: When the advisory was published
                deprecated: false
                args: []
              - name: references
                type: '[SecurityAdvisoryReference!]!'
                description: A list of references for this advisory
                deprecated: false
                args: []
              - name: severity
                type: SecurityAdvisorySeverity!
                description: The severity of the advisory
                deprecated: false
                args: []
              - name: summary
                type: String!
                description: A short plaintext summary of the advisory
                deprecated: false
                args: []
              - name: updatedAt
                type: DateTime!
                description: When the advisory was last updated
                deprecated: false
                args: []
              - name: vulnerabilities
                type: SecurityVulnerabilityConnection!
                description: Vulnerabilities associated with this Advisory
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: ecosystem
                    type: SecurityAdvisoryEcosystem
                    description: An ecosystem to filter vulnerabilities by.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
                  - name: orderBy
                    type: SecurityVulnerabilityOrder
                    description: Ordering options for the returned topics.
                    defaultValue:
                      direction: DESC
                      field: UPDATED_AT
                  - name: package
                    type: String
                    description: A package name to filter vulnerabilities by.
                  - name: severities
                    type: '[SecurityAdvisorySeverity!]'
                    description: A list of severities to filter vulnerabilities by.
              - name: withdrawnAt
                type: DateTime
                description: When the advisory was withdrawn, if it has been withdrawn
                deprecated: false
                args: []
          - nodeType: item-content
            variant: implements
            label: Implements interfaces
