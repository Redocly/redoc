  label: User
  link: docs/graphql/objects/user
  routeSlug: docs/graphql/objects/user
  content:
    contentType: item
    itemVariant: object
    meta:
      name: User
      position:
        start:
          lineNumber: 44431
          column: 1
        end:
          lineNumber: 45768
          column: 1
    seo:
      title: User
      description: A user is an individual's account on GitHub that owns repositories and can make new content.
    children:
      - nodeType: container
        children:
          - nodeType: header
            level: 2
            label: User
            showPageActions: true
          - nodeType: markdoc
            content: A user is an individual's account on GitHub that owns repositories and can make new content.
          - nodeType: item-content
            variant: requires-scopes
            graphqlTypeName: User
          - nodeType: item-content
            variant: graphql-fields
            label: Fields
            labelTranslationKey: fields
            schemaId: types/User
            graphqlTypeName: User
            graphqlSchema:
              - name: anyPinnableItems
                type: Boolean!
                description: Determine if this repository owner has any items that can be pinned to their profile.
                deprecated: false
                args:
                  - name: type
                    type: PinnableItemType
                    description: Filter to only a particular kind of pinnable item.
              - name: avatarUrl
                type: URI!
                description: A URL pointing to the user's public avatar.
                deprecated: false
                args:
                  - name: size
                    type: Int
                    description: The size of the resulting square image.
              - name: bio
                type: String
                description: The user's public profile bio.
                deprecated: false
                args: []
              - name: bioHTML
                type: HTML!
                description: The user's public profile bio as HTML.
                deprecated: false
                args: []
              - name: canReceiveOrganizationEmailsWhenNotificationsRestricted
                type: Boolean!
                description: >-
                  Could this user receive email notifications, if the organization had notification restrictions
                  enabled?
                deprecated: false
                args:
                  - name: login
                    type: String!
                    description: The login of the organization to check.
              - name: commitComments
                type: CommitCommentConnection!
                description: A list of commit comments made by this user.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
              - name: company
                type: String
                description: The user's public profile company.
                deprecated: false
                args: []
              - name: companyHTML
                type: HTML!
                description: The user's public profile company as HTML.
                deprecated: false
                args: []
              - name: contributionsCollection
                type: ContributionsCollection!
                description: The collection of contributions this user has made to different repositories.
                deprecated: false
                args:
                  - name: from
                    type: DateTime
                    description: Only contributions made at this time or later will be counted. If omitted, defaults to a year ago.
                  - name: organizationID
                    type: ID
                    description: The ID of the organization used to filter contributions.
                  - name: to
                    type: DateTime
                    description: |-
                      Only contributions made before and up to (including) this time will be
                      counted. If omitted, defaults to the current time or one year from the
                      provided from argument.
              - name: createdAt
                type: DateTime!
                description: Identifies the date and time when the object was created.
                deprecated: false
                args: []
              - name: databaseId
                type: Int
                description: Identifies the primary key from the database.
                deprecated: false
                args: []
              - name: email
                type: String!
                description: The user's publicly visible profile email.
                deprecated: false
                args: []
              - name: estimatedNextSponsorsPayoutInCents
                type: Int!
                description: The estimated next GitHub Sponsors payout for this user/organization in cents (USD).
                deprecated: false
                args: []
              - name: followers
                type: FollowerConnection!
                description: A list of users the given user is followed by.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
              - name: following
                type: FollowingConnection!
                description: A list of users the given user is following.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
              - name: gist
                type: Gist
                description: Find gist by repo name.
                deprecated: false
                args:
                  - name: name
                    type: String!
                    description: The gist name to find.
              - name: gistComments
                type: GistCommentConnection!
                description: A list of gist comments made by this user.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
              - name: gists
                type: GistConnection!
                description: A list of the Gists the user has created.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
                  - name: orderBy
                    type: GistOrder
                    description: Ordering options for gists returned from the connection
                  - name: privacy
                    type: GistPrivacy
                    description: Filters Gists according to privacy.
              - name: hasSponsorsListing
                type: Boolean!
                description: True if this user/organization has a GitHub Sponsors listing.
                deprecated: false
                args: []
              - name: hovercard
                type: Hovercard!
                description: The hovercard information for this user in a given context
                deprecated: false
                args:
                  - name: primarySubjectId
                    type: ID
                    description: The ID of the subject to get the hovercard in the context of
              - name: id
                type: ID!
                description: []
                deprecated: false
                args: []
              - name: interactionAbility
                type: RepositoryInteractionAbility
                description: The interaction ability settings for this user.
                deprecated: false
                args: []
              - name: isBountyHunter
                type: Boolean!
                description: Whether or not this user is a participant in the GitHub Security Bug Bounty.
                deprecated: false
                args: []
              - name: isCampusExpert
                type: Boolean!
                description: Whether or not this user is a participant in the GitHub Campus Experts Program.
                deprecated: false
                args: []
              - name: isDeveloperProgramMember
                type: Boolean!
                description: Whether or not this user is a GitHub Developer Program member.
                deprecated: false
                args: []
              - name: isEmployee
                type: Boolean!
                description: Whether or not this user is a GitHub employee.
                deprecated: false
                args: []
              - name: isFollowingViewer
                type: Boolean!
                description:
                  - Whether or not this user is following the viewer. Inverse of viewer_is_following
                deprecated: false
                args: []
              - name: isGitHubStar
                type: Boolean!
                description: Whether or not this user is a member of the GitHub Stars Program.
                deprecated: false
                args: []
              - name: isHireable
                type: Boolean!
                description: Whether or not the user has marked themselves as for hire.
                deprecated: false
                args: []
              - name: isSiteAdmin
                type: Boolean!
                description: Whether or not this user is a site administrator.
                deprecated: false
                args: []
              - name: isSponsoredBy
                type: Boolean!
                description: Check if the given account is sponsoring this user/organization.
                deprecated: false
                args:
                  - name: accountLogin
                    type: String!
                    description: The target account's login.
              - name: isSponsoringViewer
                type: Boolean!
                description: True if the viewer is sponsored by this user/organization.
                deprecated: false
                args: []
              - name: isViewer
                type: Boolean!
                description: Whether or not this user is the viewing user.
                deprecated: false
                args: []
              - name: issueComments
                type: IssueCommentConnection!
                description: A list of issue comments made by this user.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
                  - name: orderBy
                    type: IssueCommentOrder
                    description: Ordering options for issue comments returned from the connection.
              - name: issues
                type: IssueConnection!
                description: A list of issues associated with this user.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: filterBy
                    type: IssueFilters
                    description: Filtering options for issues returned from the connection.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: labels
                    type: '[String!]'
                    description: A list of label names to filter the pull requests by.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
                  - name: orderBy
                    type: IssueOrder
                    description: Ordering options for issues returned from the connection.
                  - name: states
                    type: '[IssueState!]'
                    description: A list of states to filter the issues by.
              - name: itemShowcase
                type: ProfileItemShowcase!
                description: |-
                  Showcases a selection of repositories and gists that the profile owner has
                  either curated or that have been selected automatically based on popularity.
                deprecated: false
                args: []
              - name: location
                type: String
                description: The user's public profile location.
                deprecated: false
                args: []
              - name: login
                type: String!
                description: The username used to login.
                deprecated: false
                args: []
              - name: monthlyEstimatedSponsorsIncomeInCents
                type: Int!
                description: The estimated monthly GitHub Sponsors income for this user/organization in cents (USD).
                deprecated: false
                args: []
              - name: name
                type: String
                description: The user's public profile name.
                deprecated: false
                args: []
              - name: organization
                type: Organization
                description: Find an organization by its login that the user belongs to.
                deprecated: false
                args:
                  - name: login
                    type: String!
                    description: The login of the organization to find.
              - name: organizationVerifiedDomainEmails
                type: '[String!]!'
                description: >-
                  Verified email addresses that match verified domains for a specified organization the user is a member
                  of.
                deprecated: false
                args:
                  - name: login
                    type: String!
                    description: The login of the organization to match verified domains from.
              - name: organizations
                type: OrganizationConnection!
                description: A list of organizations the user belongs to.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
              - name: packages
                type: PackageConnection!
                description: A list of packages under the owner.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
                  - name: names
                    type: '[String]'
                    description: Find packages by their names.
                  - name: orderBy
                    type: PackageOrder
                    description: Ordering of the returned packages.
                    defaultValue:
                      direction: DESC
                      field: CREATED_AT
                  - name: packageType
                    type: PackageType
                    description: Filter registry package by type.
                  - name: repositoryId
                    type: ID
                    description: Find packages in a repository by ID.
              - name: pinnableItems
                type: PinnableItemConnection!
                description: A list of repositories and gists this profile owner can pin to their profile.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
