            showPageActions: true
          - nodeType: markdoc
            content: Represents a range of information from a Git blame.
          - nodeType: item-content
            variant: requires-scopes
            graphqlTypeName: BlameRange
          - nodeType: item-content
            variant: graphql-fields
            label: Fields
            labelTranslationKey: fields
            schemaId: types/BlameRange
            graphqlTypeName: BlameRange
            graphqlSchema:
              - name: age
                type: Int!
                description: |-
                  Identifies the recency of the change, from 1 (new) to 10 (old). This is
                  calculated as a 2-quantile and determines the length of distance between the
                  median age of all the changes in the file and the recency of the current
                  range's change.
                deprecated: false
                args: []
              - name: commit
                type: Commit!
                description: Identifies the line author
                deprecated: false
                args: []
              - name: endingLine
                type: Int!
                description: The ending line for the range
                deprecated: false
                args: []
              - name: startingLine
                type: Int!
                description: The starting line for the range
                deprecated: false
                args: []
        panels:
