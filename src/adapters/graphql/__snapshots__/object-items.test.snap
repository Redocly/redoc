  link: docs/graphql/objects/profileitemshowcase
  routeSlug: docs/graphql/objects/profileitemshowcase
  content:
    contentType: item
    itemVariant: object
    meta:
      name: ProfileItemShowcase
      position:
        start:
          lineNumber: 25335
          column: 1
        end:
          lineNumber: 25371
          column: 1
    seo:
      title: ProfileItemShowcase
      description: |-
        A curatable list of repositories relating to a repository owner, which defaults
        to showing the most popular repositories they own.
    children:
      - nodeType: container
        children:
          - nodeType: header
            level: 2
            label: ProfileItemShowcase
            showPageActions: true
          - nodeType: markdoc
            content: |-
              A curatable list of repositories relating to a repository owner, which defaults
              to showing the most popular repositories they own.
          - nodeType: item-content
            variant: requires-scopes
            graphqlTypeName: ProfileItemShowcase
          - nodeType: item-content
            variant: graphql-fields
            label: Fields
            labelTranslationKey: fields
            schemaId: types/ProfileItemShowcase
            graphqlTypeName: ProfileItemShowcase
            graphqlSchema:
              - name: hasPinnedItems
                type: Boolean!
                description: Whether or not the owner has pinned any repositories or gists.
                deprecated: false
                args: []
              - name: items
                type: PinnableItemConnection!
                description: |-
                  The repositories and gists in the showcase. If the profile owner has any
                  pinned items, those will be returned. Otherwise, the profile owner's popular
                  repositories will be returned.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
        panels:
          - children:
              - kind: graphql-type-sample
                schemaId: types/ProfileItemShowcase
                graphqlOperationData:
                  operationType: query
                  operationName: ProfileItemShowcase
                  typeName: ProfileItemShowcase
                examples: []
          - title: Referenced in
            titleTranslationKey: referenced
            children:
              - kind: references
                graphqlTypeName: ProfileItemShowcase
                references: []
      - nodeType: container
        children:
          - nodeType: feedback
            pageSlug: /objects/profileitemshowcase
        panels: []
