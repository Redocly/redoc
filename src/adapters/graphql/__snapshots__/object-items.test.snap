          column: 1
        end:
          lineNumber: 39881
          column: 1
    seo:
      title: Team
      description: A team of users in an organization.
    children:
      - nodeType: container
        children:
          - nodeType: header
            level: 2
            label: Team
            showPageActions: true
          - nodeType: markdoc
            content: A team of users in an organization.
          - nodeType: item-content
