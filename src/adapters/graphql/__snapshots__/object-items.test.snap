  label: Topic
  link: docs/graphql/objects/topic
  routeSlug: docs/graphql/objects/topic
  content:
    contentType: item
    itemVariant: object
    meta:
      name: Topic
      position:
        start:
          lineNumber: 41502
          column: 1
        end:
          lineNumber: 41622
          column: 1
    seo:
      title: Topic
      description: A topic aggregates entities that are related to a subject.
    children:
      - nodeType: container
        children:
          - nodeType: header
            level: 2
            label: Topic
            showPageActions: true
          - nodeType: markdoc
            content: A topic aggregates entities that are related to a subject.
          - nodeType: item-content
            variant: requires-scopes
            graphqlTypeName: Topic
          - nodeType: item-content
            variant: graphql-fields
            label: Fields
            labelTranslationKey: fields
            schemaId: types/Topic
            graphqlTypeName: Topic
            graphqlSchema:
              - name: id
                type: ID!
                description: []
                deprecated: false
                args: []
              - name: name
                type: String!
                description: The topic's name.
                deprecated: false
                args: []
              - name: relatedTopics
                type: '[Topic!]!'
                description: |-
                  A list of related topics, including aliases of this topic, sorted with the most relevant
                  first. Returns up to 10 Topics.
                deprecated: false
                args:
                  - name: first
                    type: Int
                    description: How many topics to return.
                    defaultValue: 3
              - name: repositories
                type: RepositoryConnection!
                description: A list of repositories.
                deprecated: false
                args:
                  - name: affiliations
                    type: '[RepositoryAffiliation]'
                    description: |-
                      Array of viewer's affiliation options for repositories returned from the
                      connection. For example, OWNER will include only repositories that the
                      current viewer owns.
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: isLocked
                    type: Boolean
                    description: If non-null, filters repositories according to whether they have been locked
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
                  - name: orderBy
                    type: RepositoryOrder
                    description: Ordering options for repositories returned from the connection
                  - name: ownerAffiliations
                    type: '[RepositoryAffiliation]'
                    description: |-
                      Array of owner's affiliation options for repositories returned from the
                      connection. For example, OWNER will include only repositories that the
                      organization or user being viewed owns.
                    defaultValue:
                      - OWNER
                      - COLLABORATOR
                  - name: privacy
                    type: RepositoryPrivacy
                    description: If non-null, filters repositories according to privacy
                  - name: sponsorableOnly
                    type: Boolean
                    description: If true, only repositories whose owner can be sponsored via GitHub Sponsors will be returned.
                    defaultValue: false
              - name: stargazerCount
                type: Int!
                description: Returns a count of how many stargazers there are on this object
                deprecated: false
                args: []
              - name: stargazers
                type: StargazerConnection!
                description: A list of users who have starred this starrable.
                deprecated: false
                args:
                  - name: after
                    type: String
                    description: Returns the elements in the list that come after the specified cursor.
                  - name: before
                    type: String
                    description: Returns the elements in the list that come before the specified cursor.
                  - name: first
                    type: Int
                    description:
                      - Returns the first n elements from the list.
                  - name: last
                    type: Int
                    description:
                      - Returns the last n elements from the list.
                  - name: orderBy
                    type: StarOrder
                    description: Order for connection
              - name: viewerHasStarred
                type: Boolean!
                description: Returns a boolean indicating whether the viewing user has starred this starrable.
                deprecated: false
                args: []
          - nodeType: item-content
            variant: implements
            label: Implements interfaces
            labelTranslationKey: implementedInterfaces
            graphqlInterfaceNames:
              - Node
              - Starrable
        panels:
