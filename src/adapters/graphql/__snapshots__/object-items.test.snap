          column: 1
        end:
          lineNumber: 38456
          column: 1
    seo:
      title: SponsorsTier
      description: A GitHub Sponsors tier associated with a GitHub Sponsors listing.
    children:
      - nodeType: container
        children:
          - nodeType: header
            level: 2
            label: SponsorsTier
            showPageActions: true
          - nodeType: markdoc
            content: A GitHub Sponsors tier associated with a GitHub Sponsors listing.
          - nodeType: item-content
            variant: requires-scopes
            graphqlTypeName: SponsorsTier
          - nodeType: item-content
            variant: graphql-fields
            label: Fields
            labelTranslationKey: fields
            schemaId: types/SponsorsTier
            graphqlTypeName: SponsorsTier
            graphqlSchema:
              - name: adminInfo
                type: SponsorsTierAdminInfo
                description: SponsorsTier information only visible to users that can administer the associated Sponsors listing.
                deprecated: false
                args: []
              - name: closestLesserValueTier
                type: SponsorsTier
                description: |-
                  Get a different tier for this tier's maintainer that is at the same frequency
                  as this tier but with an equal or lesser cost. Returns the published tier with
                  the monthly price closest to this tier's without going over.
                deprecated: false
                args: []
              - name: createdAt
                type: DateTime!
                description: Identifies the date and time when the object was created.
                deprecated: false
                args: []
              - name: description
                type: String!
                description: The description of the tier.
                deprecated: false
                args: []
              - name: descriptionHTML
                type: HTML!
                description: The tier description rendered to HTML
                deprecated: false
                args: []
              - name: id
                type: ID!
                description: []
                deprecated: false
                args: []
              - name: isCustomAmount
                type: Boolean!
                description: |-
                  Whether this tier was chosen at checkout time by the sponsor rather than
                  defined ahead of time by the maintainer who manages the Sponsors listing.
                deprecated: false
                args: []
              - name: isOneTime
                type: Boolean!
                description: Whether this tier is only for use with one-time sponsorships.
                deprecated: false
                args: []
              - name: monthlyPriceInCents
                type: Int!
                description: How much this tier costs per month in cents.
                deprecated: false
                args: []
              - name: monthlyPriceInDollars
                type: Int!
                description: How much this tier costs per month in USD.
                deprecated: false
                args: []
              - name: name
                type: String!
                description: The name of the tier.
                deprecated: false
                args: []
              - name: sponsorsListing
                type: SponsorsListing!
                description: The sponsors listing that this tier belongs to.
                deprecated: false
                args: []
              - name: updatedAt
                type: DateTime!
                description: Identifies the date and time when the object was last updated.
                deprecated: false
                args: []
          - nodeType: item-content
            variant: implements
            label: Implements interfaces
            labelTranslationKey: implementedInterfaces
            graphqlInterfaceNames:
              - Node
        panels:
          - children:
              - kind: graphql-type-sample
