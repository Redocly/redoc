            variant: graphql-fields
            label: Fields
            labelTranslationKey: fields
            schemaId: types/Sponsorship
            graphqlTypeName: Sponsorship
            graphqlSchema:
              - name: createdAt
                type: DateTime!
                description: Identifies the date and time when the object was created.
                deprecated: false
                args: []
              - name: id
                type: ID!
                description: []
                deprecated: false
                args: []
              - name: isOneTimePayment
                type: Boolean!
                description: Whether this sponsorship represents a one-time payment versus a recurring sponsorship.
                deprecated: false
                args: []
              - name: isSponsorOptedIntoEmail
                type: Boolean
                description: |-
                  Check if the sponsor has chosen to receive sponsorship update emails sent from
                  the sponsorable. Only returns a non-null value when the viewer has permission to know this.
                deprecated: false
                args: []
              - name: maintainer
                type: User!
                description: The entity that is being sponsored
                deprecated: true
                deprecationReason: >-
                  `Sponsorship.maintainer` will be removed. Use `Sponsorship.sponsorable` instead. Removal on 2020-04-01
                  UTC.
                args: []
              - name: privacyLevel
                type: SponsorshipPrivacy!
                description: The privacy level for this sponsorship.
                deprecated: false
                args: []
              - name: sponsor
                type: User
                description: The user that is sponsoring. Returns null if the sponsorship is private or if sponsor is not a user.
                deprecated: true
                deprecationReason: >-
                  `Sponsorship.sponsor` will be removed. Use `Sponsorship.sponsorEntity` instead. Removal on 2020-10-01
                  UTC.
                args: []
              - name: sponsorEntity
                type: Sponsor
                description: The user or organization that is sponsoring, if you have permission to view them.
                deprecated: false
                args: []
              - name: sponsorable
                type: Sponsorable!
                description: The entity that is being sponsored
                deprecated: false
                args: []
              - name: tier
                type: SponsorsTier
                description: The associated sponsorship tier
                deprecated: false
                args: []
              - name: tierSelectedAt
                type: DateTime
                description: Identifies the date and time when the current tier was chosen for this sponsorship.
